def replay(t0, t1, offsets=None):
    """Re-run the frame pipeline over files for [t0, t1] (with 20 s warm-up). Returns (engine, E (frames, C))."""
    src = W.FileSource()
    chans = [c for c in src.channels()]
    eng = W.Engine(src, chans, offsets=offsets, on_segment=lambda s: None)
    k0, k1 = int((t0 - 20) * W.FPS), int(t1 * W.FPS)
    eng.k = k0
    out = []
    for k in range(k0 + W.FPS, k1 + W.FPS, W.FPS):
        eng.step(min(k, k1))
        if eng.k > t0 * W.FPS:
            ks = np.arange(max(eng.k - W.FPS, int(t0 * W.FPS)), eng.k)
            out.append(eng.E[ks % W.RING].copy())
    return eng, (np.vstack(out) if out else np.zeros((0, len(chans))))


def cmd_timeline(arg, outfile):
    from PIL import Image, ImageDraw, ImageFont
    t0, t1 = parse_range(arg, 300)
    st = json.loads(STATE.read_text()) if STATE.exists() else {}
    eng, E = replay(t0, t1, st.get("offsets"))
    rows = [i for i in range(E.shape[1]) if not np.isnan(E[:, i]).all()]
    if not rows:
        sys.exit("who-said: no mic audio in that range")
    segs = [s for s in load_segs(t0, t1) if s.get("status") in ("emitted", "ok")]
    Wd, left, rowh, top = 1400, 150, 70, 30
    H = top + rowh * len(rows) + 40
    img = Image.new("RGB", (Wd, H), (18, 18, 22))
    d = ImageDraw.Draw(img)
    font = ImageFont.load_default(size=14)
    px = lambda t: left + (t - t0) / (t1 - t0) * (Wd - left - 10)
    span = t1 - t0
    step = next(s for s in (5, 10, 15, 30, 60, 120, 300, 600, 900, 1800, 3600) if span / s <= 14)
    for tt in np.arange(np.ceil(t0 / step) * step, t1, step):
        d.line([(px(tt), top), (px(tt), H - 30)], fill=(50, 50, 58))
        d.text((px(tt) - 25, H - 25), W.hms(tt), fill=(170, 170, 170), font=font)
    nfr = len(E)
    for r, ci in enumerate(rows):
        c = eng.chans[ci]
        y0 = top + r * rowh
        d.text((8, y0 + rowh / 2 - 16), c, fill=(220, 220, 220), font=font)
        d.text((8, y0 + rowh / 2 + 2), W.OWNERS.get(c, "room mic"), fill=COLORS.get(W.OWNERS.get(c), (150, 150, 150)), font=font)
        d.line([(left, y0 + rowh - 2), (Wd - 10, y0 + rowh - 2)], fill=(60, 60, 66))
        e = np.nan_to_num(E[:, ci], nan=0)
        cols = np.full((nfr, 3), 90)
        for s in segs:
            if s["chan"] == c:
                a, b = int((s["t0"] - t0) * W.FPS), int((s["t1"] - t0) * W.FPS)
                cols[max(a, 0):max(b, 0)] = COLORS.get(s["label"], COLORS["unknown"])
        xs = np.linspace(0, nfr, Wd - left - 10, endpoint=False).astype(int)
        for i, k in enumerate(xs):
            kk = slice(k, max(k + 1, int(xs[i + 1]) if i + 1 < len(xs) else nfr))
            v = float(e[kk].max())
            h = min(v / 40.0, 1.0) * (rowh - 8)
            if h > 0.5:
                d.line([(left + i, y0 + rowh - 3), (left + i, y0 + rowh - 3 - h)], fill=tuple(int(x) for x in cols[kk].max(0)))
        for s in segs:
            if s["chan"] == c:
                d.text((max(px(s["t0"]), left) + 2, y0 + 2), f"{s['name']} {s['conf']:.1f}", fill=COLORS.get(s["label"], COLORS["unknown"]), font=font)
    d.text((left, 6), f"who-said  {time.strftime('%Y-%m-%d %H:%M:%S', time.localtime(t0))} - {W.hms(t1)}   "
           f"bars = residual (\"near this Deck\") energy, 0-40 dB; colour = attributed speaker (grey = none)",
           fill=(200, 200, 200), font=font)
    out = Path(outfile) if outfile else WHO / "timeline.png"
    img.save(out)
    print(out)


# ======================================================================== synthetic overlap test
def cmd_test_synth(n_pairs):
    """Pairs of confident, single-speaker segments from different Decks. For each pair the real multichannel
    recordings (all Decks) of both moments are summed sample by sample (with their measured offsets), so the
    mixture has real room acoustics. Then the same pipeline separates it and Whisper reads each Deck's part.
    Reference words = Whisper large-v3-turbo on the clean (unmixed) owner Deck audio."""
    from faster_whisper import WhisperModel
    low_priority_thread()
    segs = [s for s in load_segs(time.time() - 7000, time.time())
            if s.get("label") == s.get("owner") and (s.get("margin_db") or 0) >= 8 and not s.get("with")
            and len(W.words(s.get("text", ""))) >= 4 and 1.5 <= s["t1"] - s["t0"] <= 8]
    by = {}
    for s in segs:
        by.setdefault(s["chan"], []).append(s)
    decks = sorted(by)
    if len(decks) < 2:
        sys.exit(f"who-said: need confident segments from 2+ Decks (have {', '.join(f'{d}:{len(by[d])}' for d in decks) or 'none'})")
    st = json.loads(STATE.read_text()) if STATE.exists() else {}
    off = st.get("offsets", {})
    src = W.FileSource()
    chans = list(src.channels())
    ref_model = WhisperModel("large-v3-turbo", device="cpu", compute_type="int8", cpu_threads=ASR_THREADS)
    asr = ASR()

    def ref_text(a):
        r, _ = ref_model.transcribe(a.astype(np.float32), language="en", beam_size=1, vad_filter=True, condition_on_previous_text=False)
        return " ".join(x.text.strip() for x in r)

    rng = np.random.default_rng(1)
    results = []
    for p in range(n_pairs):
        da, db = rng.choice(decks, 2, replace=False)
        A, B = by[da][rng.integers(len(by[da]))], by[db][rng.integers(len(by[db]))]
        L = max(A["t1"] - A["t0"], B["t1"] - B["t0"]) + 2.0
        n = int(L * W.RATE)
        mix, clean = {}, {}
        for c in chans:
            xa, oka = src.read(c, A["t0"] - 1 + off.get(c, 0), n)
            xb, okb = src.read(c, B["t0"] - 1 + off.get(c, 0), n)
            if oka.mean() > 0.9 and okb.mean() > 0.9:
                mix[c] = (0.0, xa + xb)
                clean[c] = (xa, xb)
        if da not in mix or db not in mix:
            continue
        # the mixture starts "at time 0"; warm the floors with 20 s of the A recording's past
        eng = W.Engine(W.ArraySource({c: (-20.0, np.concatenate([src.read(c, A["t0"] - 21 + off.get(c, 0), 20 * W.RATE)[0], v[1]]))
                                      for c, v in mix.items()}), list(mix))
        eng.k = -20 * W.FPS
        eng.step(int(L * W.FPS) - 1)
        ka, kb = W.FPS // 2, int(L * W.FPS) - W.FPS // 2
        row = {}
        for who, d, S, i in (("A", da, A, 0), ("B", db, B, 1)):
            ref = ref_text(clean[d][i])
            sep = asr(eng.masked_audio(d, ka, kb))[0]
            raw = asr(mix[d][1][ka * W.HOP:kb * W.HOP])[0]
            cl = asr(eng.masked_audio(d, ka, kb, use_mask=False) * 0 + clean[d][i][ka * W.HOP:kb * W.HOP])[0]
            row[who] = dict(deck=d, ref=ref, wer_sep=W.wer(ref, sep), wer_raw_mix=W.wer(ref, raw), wer_clean_small=W.wer(ref, cl))
        results.append(row)
        print(f"pair {p + 1}: {da} + {db}: " + "  ".join(f"{k}: sep {v['wer_sep']:.0%} rawmix {v['wer_raw_mix']:.0%} clean {v['wer_clean_small']:.0%}" for k, v in row.items()), flush=True)
    if results:
        allv = [v for r in results for v in r.values()]
        print(f"\nword error rate over {len(allv)} voices in {len(results)} overlapping pairs (reference = large-v3-turbo on clean audio):")
        for k, name in (("wer_clean_small", "clean speech, small.en"), ("wer_sep", "overlap, separated (residual mask)"),
                        ("wer_raw_mix", "overlap, raw Deck mic (no separation)")):
            print(f"  {name:<40} {np.mean([v[k] for v in allv]):.0%}")
        (WHO / "test-synth.json").write_text(json.dumps(results, indent=1))


# ======================================================================== main
def main():
    a = sys.argv[1:]
    if not a or not a[0].startswith("--"):
        return cmd_list(a[0] if a else None)
    if a[0] == "--serve":
        return Daemon().serve()
    if a[0] == "--replay":
        return Daemon().replay(*parse_range(a[1] if len(a) > 1 else None))
    if a[0] == "--enroll":
        if len(a) < 2:
            sys.exit("usage: who-said --enroll NAME [HH:MM:SS]")
        return cmd_enroll(a[1], a[2] if len(a) > 2 else None)
    if a[0] == "--profiles":
        return cmd_profiles()
    if a[0] == "--status":
        return cmd_status()
    if a[0] == "--timeline":
        out = a[a.index("-o") + 1] if "-o" in a else None
        rest = [x for i, x in enumerate(a[1:], 1) if x != "-o" and a[i - 1] != "-o"]
        return cmd_timeline(rest[0] if rest else None, out)
    if a[0] == "--test-synth":
        return cmd_test_synth(int(a[1]) if len(a) > 1 else 6)
    print(__doc__)


if __name__ == "__main__":
    main()

        print(f"{name:<10} deck {k.get('deck', [0, 0])[1]:>3} samples   room {k.get('room', [0, 0])[1]:>3} samples")


def cmd_status():
    if not STATE.exists():
        sys.exit("who-said: no state yet (service not running?)")
    st = json.loads(STATE.read_text())
    age = time.time() - st["heartbeat"]
    print(f"daemon {'alive' if age < 15 else 'STALE'} ({age:.0f} s ago), cpu {st['cpu_pct']}% of one core, queue {st['queue']}")
    print("live mics:", ", ".join(st["live"]) or "none", "| room mic", "on" if st["room_live"] else "off")
    print("offsets ms:", {c: round(v * 1000, 1) for c, v in st["offsets"].items() if v})
    if st.get("align"):
        print("alignment fit residual ms:", st["align"][0], "\n  pair spread (IQR) ms:", st["align"][1])
    print("counts:", st["stats"])



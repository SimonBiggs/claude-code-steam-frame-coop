#!/bin/bash
# test-throttle: keep Claude's test games from making the family's games stutter (Simon, 2026-10-24: "David's game
# is stuttering"). Every 3 s, every headless / offscreen test Godot (--headless, or the offscreen runner's
# --audio-driver Dummy) and its gamescope get SCHED_IDLE (CPU only when nothing else wants it) and the last 4 threads.
# Also the sheet/video/thumbnail helpers (recsheet.py, ffmpeg, pillow). Real games (the TV game, Steam games) are never touched.
cores="$(( $(nproc) - 4 ))-$(( $(nproc) - 1 ))"
while true; do
  for pid in $(pgrep -f -- 'godot.*(--headless|--audio-driver Dummy)|gamescope --backend headless|recsheet.py|ffmpeg -y -loglevel error|uv run --quiet --with pillow'); do
    [ "$(chrt -p "$pid" 2>/dev/null | grep -c SCHED_IDLE)" = 1 ] && continue
    for t in /proc/$pid/task/*; do tid=${t##*/}; chrt -i -p 0 "$tid" 2>/dev/null; taskset -cp "$cores" "$tid" >/dev/null 2>&1; done
  done
  # Guard (Simon: his PlayStation pad must never connect to a test game): a test Godot that can see the real
  # controllers was started without godot-test / gdev's sandbox. Stop it and say so on Claude's channel.
  for pid in $(pgrep -f -- '^(\S*/)?(godot|Godot_v\S*) .*(--headless|--audio-driver Dummy)'); do
    [ "$(tr '\0' ' ' < /proc/$pid/cmdline 2>/dev/null | cut -d' ' -f1)" = timeout ] && continue
    if ls /proc/$pid/root/dev/input/ 2>/dev/null | grep -q '^event'; then
      cmd=$(tr '\0' ' ' < /proc/$pid/cmdline 2>/dev/null | cut -c1-160)
      kill "$pid" 2>/dev/null
      echo "⚠ controller guard: stopped a test Godot that could see the real controllers (use godot-test): $cmd" | "$HOME/.local/bin/brepl" --pipe controller-guard >/dev/null 2>&1
    fi
  done
  # Guard: an offscreen (headless) gamescope must never hold a low X display (:0-:19): Steam sends Gaming Mode games
  # to :1, and they were opening inside a hidden test display instead of on the TV. godot.ts reserves :0-:19.
  ss -xlpn 2>/dev/null | grep -oE '@/tmp/.X11-unix/X[0-9]+ .*pid=[0-9]+' | sed -E 's/.*X([0-9]+) .*pid=([0-9]+).*/\1 \2/' |
    while read -r n pid; do
      [ "$n" -lt 20 ] || continue
      tr '\0' ' ' < /proc/$pid/cmdline 2>/dev/null | grep -q -- '--backend headless' || continue
      kill "$pid" 2>/dev/null
      echo "⚠ display guard: stopped an offscreen gamescope holding X display :$n (the TV's games need it)" | "$HOME/.local/bin/brepl" --pipe display-guard >/dev/null 2>&1
    done
  sleep 3
done

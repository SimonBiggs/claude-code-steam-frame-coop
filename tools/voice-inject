#!/usr/bin/env python3
"""voice-inject [PANE]: type spoken requests into a Claude Code session running in tmux.

Watches the voice bridge log and sends each NEW line addressed to Claude ("TO CLAUDE: ...")
into the tmux pane as a message, so Claude gets it like typed input.
Only bytes appended after start-up are read. If the log shrinks or is replaced, it jumps to the
new end instead of replaying old lines.
  voice-inject --here   remember the current tmux pane ($TMUX_PANE) as the target
  voice-inject --all    forward everything said, without needing "Claude" (combine with --print)
  voice-inject --print  print each new request to stdout instead (for a Claude Code Monitor)
The bridge's accurate pass appends "[HH:MM:SS] ~ Name: text" corrections (same timestamp as the fast line);
these come through as "[voice HH:MM:SS fix] Name: text" when they say something different.
Speaker labels (who-said service, 2026-10-24): when it is running, lines gain a "[Name]" field after the voice
prefix: "[voice HH:MM:SS] [David] David?: text" (room mic; the old bridge name stays as it was), and each
Deck's own "near this Deck" transcript comes through as "[voice HH:MM:SS deck] [David] text" (one line per
person, also when several talk at once). "[unknown]" = not sure who. WHO_LABELS=0 turns both off.
"""
import difflib, os, re, subprocess, sys, time

LOG = os.environ.get("VOICE_LOG", os.path.expanduser("~/GodotProjects/duo-arena/.dev/voice.log"))
PANE_FILE = os.path.expanduser("~/.claude/voice-pane")

if sys.argv[1:] == ["--here"]:
    open(PANE_FILE, "w").write(os.environ["TMUX_PANE"] + "\n")
    print("voice requests will go to pane", os.environ["TMUX_PANE"])
    sys.exit(0)

# Only ONE Claude session may receive the voice feed (Simon, 2026-10-17): a second copy exits at once.
import fcntl
_lock = open(os.path.expanduser("~/.claude/voice-inject.lock"), "w")
try:
    fcntl.flock(_lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
except BlockingIOError:
    print("voice-inject: another Claude session already has the voice feed; not starting", flush=True)
    sys.exit(1)


# Rude words are masked in the text the family sees on the TV (Simon, 2026-10-17).
RUDE = re.compile(r"\b(penis|penises|vagina|bum|butt|poo+|poop|wee|willy|fart\w*|sh[i1]t\w*|f[u*]ck\w*|"
                  r"bitch\w*|crap\w*|damn\w*|dick\w*|cock\w*|arse\w*|ass|asshole\w*|bastard\w*|piss\w*|"
                  r"bloody|bollock\w*|twat\w*|wank\w*|boob\w*|nipple\w*|sex\w*|stupid|idiot\w*|hell)\b", re.I)


def clean(text: str) -> str:
    return RUDE.sub("***", text)


def mc_show(msg: str) -> None:
    """Show what the mic heard in Minecraft chat (grey) when the game is connected (Simon, 15:28)."""
    import json, threading, urllib.request
    m = re.match(r"\[voice ([^\]]+)\] (.*)", msg)
    text = ("fix: " if m and m.group(1).endswith(" fix") else "") + m.group(2) if m else msg
    cmd = "tellraw @a " + json.dumps({"rawtext": [{"text": "\u00a77" + text}]})

    def send():
        try:
            urllib.request.urlopen(urllib.request.Request("http://127.0.0.1:3001/cmd", data=cmd.encode()), timeout=5)
        except OSError:
            pass
    threading.Thread(target=send, daemon=True).start()


def pane() -> str:
    if len(sys.argv) > 1:
        return sys.argv[1]
    return open(PANE_FILE).read().strip()


SAID = os.path.expanduser("~/.claude/said.log")


def _norm(t: str) -> str:
    return re.sub(r"[^a-z0-9 ]", "", t.lower()).strip()


def echo_of_claude(text: str) -> bool:
    """True if this transcript is the mic hearing Claude's own frame-say speech from the TV."""
    try:
        lines = open(SAID).read().splitlines()[-20:]
    except FileNotFoundError:
        return False
    heard = _norm(text)
    if len(heard) < 4:
        return False
    now = time.time()
    for line in lines:
        ts, _, said = line.partition("\t")
        if not ts.isdigit() or now - int(ts) > 90:
            continue
        said = _norm(said)
        if heard in said:
            return True
        m = difflib.SequenceMatcher(None, heard, said).find_longest_match(0, len(heard), 0, len(said))
        if m.size >= 0.6 * len(heard):
            return True
    return False


WHO_DIR = os.path.join(os.path.dirname(LOG), "who")
WHO_ON = os.environ.get("WHO_LABELS", "1") == "1"
WHO_WAIT = float(os.environ.get("WHO_WAIT", "2.0"))  # max seconds to wait for a room line's speaker label
who_cache: dict = {}


def who_state():
    try:
        import json
        st = json.load(open(os.path.join(WHO_DIR, "state.json")))
        return st if time.time() - st["heartbeat"] < 15 else None
    except Exception:
        return None


def who_label(ts: str) -> str:
    """'[Name] ' for a room-mic line (from who-said's labels.jsonl), waiting briefly; '' if who-said is not running."""
    if not WHO_ON:
        return ""
    if ts in who_cache:
        return who_cache[ts]
    st = who_state()
    if not st or not st.get("room_live"):
        return ""
    import json
    deadline = time.time() + WHO_WAIT
    while True:
        try:
            with open(os.path.join(WHO_DIR, "labels.jsonl"), "rb") as f:
                f.seek(max(0, os.fstat(f.fileno()).st_size - 20000))
                for raw in f.read().splitlines()[::-1]:
                    try:
                        r = json.loads(raw)
                    except ValueError:
                        continue
                    if r.get("stamp") == ts:
                        who_cache[ts] = f"[{r['name']}] "
                        if len(who_cache) > 300:
                            for k in list(who_cache)[:100]:
                                who_cache.pop(k)
                        return who_cache[ts]
        except FileNotFoundError:
            pass
        if time.time() > deadline:
            return "[unknown] "
        time.sleep(0.1)


feed_pos = None  # who-said's per-Deck transcript feed (feed.log); start at its end like the voice log


def who_feed() -> list:
    """New per-Deck lines from who-said: '[HH:MM:SS] [Name] text' -> ('[voice HH:MM:SS deck] [Name] text', text)."""
    global feed_pos
    if not WHO_ON:
        return []
    p = os.path.join(WHO_DIR, "feed.log")
    try:
        size = os.path.getsize(p)
    except OSError:
        feed_pos = 0  # not there yet: read it from the start once it appears
        return []
    if feed_pos is None or size < feed_pos:
        feed_pos = size if feed_pos is None else 0
        return [] if size == feed_pos else who_feed()
    if size == feed_pos:
        return []
    with open(p, "rb") as f:
        f.seek(feed_pos)
        data = f.read(size - feed_pos)
    keep = data.rfind(b"\n") + 1
    feed_pos += keep
    out = []
    for line in data[:keep].decode("utf-8", "replace").splitlines():
        m = re.match(r"\[(\d\d:\d\d:\d\d)\] (\[[^\]]+\]) (.*)", line)
        if m:
            out.append((f"[voice {m.group(1)} deck] {m.group(2)} {m.group(3)}", m.group(3)))
    return out


def deliver(msg: str) -> None:
    msg = clean(msg)
    mc_show(msg)
    if PRINT:
        print(msg, flush=True)
        with open(os.path.join(os.path.dirname(LOG), "voice-timing.log"), "a") as f:
            f.write(f"event_sent {time.time():.2f} | {msg[:50]}\n")
        return
    p = pane()
    subprocess.run(["/usr/bin/tmux", "send-keys", "-t", p, "-l", msg])
    subprocess.run(["/usr/bin/tmux", "send-keys", "-t", p, "Enter"])


def stat():
    try:
        st = os.stat(LOG)
        return st.st_ino, st.st_size
    except FileNotFoundError:
        return None, 0


PRINT = "--print" in sys.argv
if PRINT:
    sys.argv.remove("--print")
# After someone says "Claude", everything said in the next FOLLOW_S seconds also comes through
# (a fixed window; only "Claude" opens it again), so follow-ups don't need the wake word.
FOLLOW_S = float(os.environ.get("VOICE_FOLLOW_S", "60"))
follow_until = 0.0
ALL = "--all" in sys.argv  # forward every transcribed line, not just ones after "Claude"
if ALL:
    sys.argv.remove("--all")
ino, pos = stat()  # start at the current end: never send old lines
buf = b""
heard: dict = {}  # timestamp -> fast-pass texts, to drop corrections that only change punctuation
sent: set = set()  # timestamps whose fast line was passed on (their corrections follow them)
FIX_RE = re.compile(r"\[(\d\d:\d\d:\d\d)\] ~ (TO CLAUDE: )?([^:]+): (.*)")
while True:
    time.sleep(0.1)
    for msg, text in who_feed():
        if not echo_of_claude(text):
            deliver(msg)
    new_ino, size = stat()
    if new_ino != ino or size < pos:  # replaced or truncated: skip to the end
        ino, pos, buf = new_ino, size, b""
        continue
    if size == pos:
        continue
    with open(LOG, "rb") as f:
        f.seek(pos)
        buf += f.read(size - pos)
    pos = size
    *lines, buf = buf.split(b"\n")
    for raw in lines:
        line = raw.decode("utf-8", "replace")
        fix = FIX_RE.match(line)
        if not fix and line.startswith("[") and ": " in line:
            heard.setdefault(line[1:9], set()).add(_norm(line[11:].removeprefix("TO CLAUDE: ").split(": ", 1)[-1]))
        if len(heard) > 300:  # forget the oldest
            for k in list(heard)[:100]:
                heard.pop(k), sent.discard(k)
        if fix:
            ts, to_claude, name, text = fix.groups()
            if _norm(text) in heard.get(ts, ()):
                continue  # same words as the fast line
            if to_claude:
                follow_until = time.time() + FOLLOW_S
            elif not (ALL or ts in sent or time.time() < follow_until):
                continue
            msg = f"[voice {ts} fix] {name}: {text}"
        elif "TO CLAUDE: " in line:
            follow_until = time.time() + FOLLOW_S  # conversation mode: keep listening a while
            msg = f"[voice {line[1:9]}] " + line.split("TO CLAUDE: ", 1)[1]
        elif (ALL or time.time() < follow_until) and line.startswith("[") and "] " in line:
            # The window is fixed: chatter inside it must not keep it open forever.
            msg = f"[voice {line[1:9]}] " + line.split("] ", 1)[1]
        else:
            continue
        if "] Claude (TV): " in msg or echo_of_claude(msg.split(": ", 1)[-1]):
            continue  # the mic heard Claude's own speech from the TV
        if not fix:
            sent.add(line[1:9])
        head, _, rest = msg.partition("] ")
        msg = f"{head}] {who_label(head.split()[1])}{rest}"
        deliver(msg)

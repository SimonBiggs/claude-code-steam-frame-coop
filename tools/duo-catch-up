#!/bin/bash
# duo-catch-up: devices that were offline during a duo-deploy get it as soon as they're back online.
# duo-deploy / duo-deploy-deck leave a marker in ~/.cache/duo-deploy-pending/<frame|deck alias>; a successful deploy
# removes it. A marker keeps the time of the FIRST deploy that device missed (dev.debt flags ones older than 3 days).
# Run every 2 minutes by duo-catch-up.timer.
for m in ~/.cache/duo-deploy-pending/*; do
  [ -e "$m" ] || continue
  d=$(basename "$m")
  if [ "$d" = frame ]; then duo-deploy-frame; else duo-deploy-deck "$d"; fi >/dev/null 2>&1 && echo "caught up: $d"
done
# One-off jobs for a device that was offline (e.g. installing tools on a Deck): ~/.cache/duo-pending-cmds/*.sh, each
# exits non-zero while its device is unreachable and is deleted once it succeeds.
for s in ~/.cache/duo-pending-cmds/*.sh; do
  [ -e "$s" ] || continue
  timeout 120 bash "$s" >/dev/null 2>&1 && rm -f "$s" && echo "ran: $(basename "$s")"
done
# Who plays what (~/GodotProjects/play-record, dev.favourites()): read-only Steam sessions + playtime from the TV and
# whichever Decks are reachable, arcade telemetry, voice comments -> favourites.md. It limits itself to every 15 min.
pr=~/GodotProjects/play-record/play-record
[ -x "$pr" ] && { timeout 150 "$pr" collect --if-due 15 >>~/.cache/play-record.log 2>&1 || echo "play-record failed (see ~/.cache/play-record.log)"; }
# Our games in every Steam library (TV + Decks, every account): shortcut, library art, "Family Games" collection
# (family-games-sync, 2026-11-25; never closes Steam; the logged-in account only gets shortcuts while nothing is played)
fgs=~/.local/bin/family-games-sync
[ -x "$fgs" ] && { timeout 240 "$fgs" --if-due 15 || echo "family-games-sync failed (see ~/.cache/family-games-sync.log)"; }
exit 0

#!/bin/bash
# duo-catch-up: devices that were offline during a duo-deploy get it as soon as they're back online.
# duo-deploy / duo-deploy-deck leave a marker in ~/.cache/duo-deploy-pending/<frame|deck alias>; a successful deploy
# removes it. A marker keeps the time of the FIRST deploy that device missed (dev.debt flags ones older than 3 days).
# Run every 2 minutes by duo-catch-up.timer.
for m in ~/.cache/duo-deploy-pending/*; do
  [ -e "$m" ] || continue
  d=$(basename "$m")
  if [ "$d" = frame ]; then duo-deploy-frame; else duo-deploy-deck "$d"; fi >/dev/null 2>&1 && echo "caught up: $d"
done
# One-off jobs for a device that was offline (e.g. installing tools on a Deck): ~/.cache/duo-pending-cmds/*.sh, each
# exits non-zero while its device is unreachable and is deleted once it succeeds.
for s in ~/.cache/duo-pending-cmds/*.sh; do
  [ -e "$s" ] || continue
  timeout 120 bash "$s" >/dev/null 2>&1 && rm -f "$s" && echo "ran: $(basename "$s")"
done
exit 0

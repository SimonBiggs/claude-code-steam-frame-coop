#!/bin/bash
# duo-deploy "message": ship the staging copy's code (core/, games/, arcade/, tests/) to the live
# project on this machine and to the Steam Frame (both hot-reload), then commit and push to GitHub.
set -e
msg="$1"
ST=~/GodotProjects/.duo-arena-stage; LIVE=~/GodotProjects/duo-arena; B=~/GodotProjects/duo-arena-frame-build
K=~/.config/steamos-devkit/devkit_rsa
# VR text rule: far text must never draw over nearer things (it hurts to look at in the headset).
if bad=$(grep -rn "no_depth_test = true" "$ST/core" "$ST/games" "$ST/arcade" --include='*.gd'); then
  echo "NOT deploying: Label3D.no_depth_test = true breaks VR depth (see docs/GAME_DEV_GUIDE.md):" >&2
  echo "$bad" >&2; exit 1
fi
# get_meta(key, null): in Godot a null default means "no default", so a missing key prints an error
# (every frame in the arcade menu once). Use get_meta(k) if has_meta(k) else null, or a typed default.
if bad=$(grep -rnE 'get_meta\([^()]*,[[:space:]]*null[[:space:]]*\)' "$ST/core" "$ST/games" "$ST/arcade" "$ST/tests" --include='*.gd' | grep -vE ':[0-9]+:[^#]*#.*get_meta\('); then  # (comments mentioning it are fine)
  echo "NOT deploying: get_meta(key, null) errors when the key is missing - use 'get_meta(k) if has_meta(k) else null':" >&2
  echo "$bad" >&2; exit 1
fi
# Live must not be ahead of staging (e.g. an agent branch merged straight into live): the rsync below
# would silently roll that work back. Sync it into staging first (rsync live -> stage) and redeploy.
ahead=$(cd "$LIVE" && for d in core games arcade tests; do find "$d" -type f ! -name "*.uid"; done |
  while read -r f; do [ -f "$ST/$f" ] && ! cmp -s "$LIVE/$f" "$ST/$f" && [ "$LIVE/$f" -nt "$ST/$f" ] && echo "$f"; done || true)
# (|| true: the loop's status is its last test's, and under set -e a false one silently ended every deploy)
if [ -n "$ahead" ]; then
  echo "NOT deploying: live has newer files than staging (copy them into $ST first):" >&2
  echo "$ahead" >&2; exit 1
fi
for d in core games arcade tests; do rsync -a --delete --exclude '*.uid' "$ST/$d/" "$LIVE/$d/"; done
cp "$ST/arcade.tscn" "$LIVE/arcade.tscn"
# LAN updates (docs/MULTI_MACHINE.md "Updates over the home network"): the boot guard + pinned root key travel with
# deploys (addons/ is never part of a LAN update), then what's live is signed with this machine's root key, so every
# machine it plays with picks it up over the home network (the Frame/Deck copies below carry the signed manifest too).
[ -d "$ST/addons/lan_update" ] && rsync -a --delete --exclude '*.uid' "$ST/addons/lan_update/" "$LIVE/addons/lan_update/"
if [ -f "$LIVE/addons/lan_update/root.pub.pem" ]; then
  duo-update-bundle "$LIVE" || echo "⚠ LAN update not signed (duo-update-bundle failed): devices still get this deploy over SSH" >&2
fi
rsync -a --delete --exclude .git --exclude .dev --exclude .godot --exclude launch.sh --exclude tools "$LIVE/" "$B/game/"
if ssh -o ConnectTimeout=4 -o BatchMode=yes -i $K steamos@frame true 2>/dev/null; then
  rsync -az -e "ssh -i $K" --exclude .godot --exclude .dev "$B/game/" steamos@frame:devkit-game/DuoArena/game/
else
  echo "Steam Frame offline: duo-catch-up deploys it when it's back" >&2
  mkdir -p ~/.cache/duo-deploy-pending; touch ~/.cache/duo-deploy-pending/frame
fi
# Simon's Steam Deck plays too (another TV-style player, or on its own): ~/DuoArena via duo-deploy-deck.
duo-deploy-deck >/dev/null || true
cd "$LIVE" && git add -A && git commit -q -m "$msg

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>" && git log --oneline -1
# Back up to GitHub (quietly, in the background; a failed push just waits for the next one).
# A failed push is said out loud on Claude's channel (the token expired once and 46 commits sat unpushed unnoticed).
( git push -q origin main >/dev/null 2>&1 || echo "⚠ github: push failed ($(git rev-list --count origin/main..main) commits waiting) - gh auth status" | "$HOME/.local/bin/brepl" --pipe github >/dev/null 2>&1 & )

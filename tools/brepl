#!/usr/bin/env bun
// brepl: a persistent async Bun REPL that Claude talks to from the shell (Simon, 2026-10-18: "you'll be able
// to do a lot of things quicker if you're using an async Bun REPL").
//   brepl 'await fetch("http://127.0.0.1:3001").then(r => r.status)'   evaluate, print the result
//   echo 'x = 41; x + 1' | brepl                                        code from stdin
//   brepl --restart | --stop                                            restart / stop the server
// One server per user on ~/.cache/brepl.sock, started on first use. State persists between calls:
// bare assignments (x = 1) and globalThis.* live on; const/let/var stay local to that call.
// The last expression is returned (top-level await works). console.log output is printed before the result.
import { existsSync, unlinkSync } from "node:fs";
import { inspect } from "node:util";
import { spawn } from "node:child_process";

const SOCK = `${process.env.HOME}/.cache/brepl.sock`;
const args = process.argv.slice(2);

if (args[0] === "--serve") {
  if (existsSync(SOCK)) unlinkSync(SOCK);
  // Offscreen Godot test runs (~/.local/share/gdev/godot.ts): godot.launch("duo-arena"), g.ui(), g.joy("a"), g.shot()...
  globalThis.godot = await import(`${process.env.HOME}/.local/share/gdev/godot.ts`).catch((e) => ({ error: String(e) }));
  // Dev-loop helpers (~/.local/share/brepl/dev.ts): dev.help(), dev.debt(), dev.bots.all(), dev.stage.diff(), ...
  globalThis.dev = await import(`${process.env.HOME}/.local/share/brepl/dev.ts`).catch((e) => ({ error: String(e) }));
  // reload(): pick up edits to godot.ts / dev.ts without restarting (running offscreen games keep their old code).
  globalThis.reload = async () => {
    const t = Date.now();
    globalThis.godot = await import(`${process.env.HOME}/.local/share/gdev/godot.ts?t=${t}`);
    globalThis.dev = await import(`${process.env.HOME}/.local/share/brepl/dev.ts?t=${t}`);
    return "reloaded godot + dev";
  };
  const AsyncFunction = (async () => {}).constructor;
  // show(...paths): images to hand back with the result. The brepl MCP tool (~/.local/share/brepl/mcp.ts)
  // returns them as pictures; the CLI just lists them. Returned image paths (or arrays of them) count too.
  const IMG = /\.(png|jpe?g|webp|gif)$/i;
  let shown = [];
  globalThis.show = (...paths) => { for (const p of paths.flat()) if (typeof p === "string") shown.push(p); return paths.flat().length; };
  // Background jobs (Simon, 2026-10-24): bg(name, async ({log, show}) => ...) returns at once; poll({wait})
  // hands back every job finished since the last poll (output + images) and lists the running ones. Each
  // finish is also a line in ~/.cache/brepl/jobs.log, for a Monitor to wake Claude.
  const JOBS_LOG = `${process.env.HOME}/.cache/brepl/jobs.log`;
  const { mkdirSync, appendFileSync } = await import("node:fs");
  mkdirSync(`${process.env.HOME}/.cache/brepl`, { recursive: true });
  const jobs = new Map();
  let jobSeq = 0, wake = () => {};
  globalThis.bg = (name, fn) => {
    if (typeof name === "function") [name, fn] = ["job", name];
    const job = { id: ++jobSeq, name, started: Date.now(), status: "running", lines: [], images: [], value: undefined, polled: false };
    jobs.set(job.id, job);
    const ctx = {
      log: (...a) => { job.lines.push(a.map((x) => (typeof x === "string" ? x : inspect(x, { depth: 3 }))).join(" ")); },
      show: (...paths) => { for (const p of paths.flat()) if (typeof p === "string") job.images.push(p); },
    };
    Promise.resolve().then(() => fn(ctx)).then(
      (v) => { job.status = "done"; job.value = v; for (const x of [v].flat()) if (typeof x === "string" && IMG.test(x)) job.images.push(x); },
      (e) => { job.status = "failed"; job.value = e?.stack ?? String(e); },
    ).finally(() => {
      job.ended = Date.now();
      appendFileSync(JOBS_LOG, `${new Date().toTimeString().slice(0, 8)} job #${job.id} ${job.name} ${job.status} (${((job.ended - job.started) / 1000).toFixed(0)}s)\n`);
      wake();
    });
    return `started job #${job.id} ${name} (poll() for results)`;
  };
  globalThis.poll = async ({ wait = 0 } = {}) => {
    const ready = () => [...jobs.values()].filter((j) => j.status !== "running" && !j.polled);
    if (!ready().length && wait > 0 && [...jobs.values()].some((j) => j.status === "running"))
      await Promise.race([new Promise((r) => (wake = r)), Bun.sleep(wait * 1000)]);
    const done = ready();
    for (const j of done) { j.polled = true; for (const p of j.images) show(p); }
    const fmt = (j) => [`── job #${j.id} ${j.name}: ${j.status} in ${(((j.ended ?? Date.now()) - j.started) / 1000).toFixed(0)}s`,
      ...j.lines, ...(j.value !== undefined ? [typeof j.value === "string" ? j.value : inspect(j.value, { depth: 4 })] : [])].join("\n");
    const running = [...jobs.values()].filter((j) => j.status === "running").map((j) => `#${j.id} ${j.name} (${((Date.now() - j.started) / 1000).toFixed(0)}s)`);
    return [...done.map(fmt), running.length ? `still running: ${running.join(", ")}` : done.length ? "" : "nothing running"].filter(Boolean).join("\n");
  };
  globalThis.jobs = () => [...jobs.values()].map((j) => ({ id: j.id, name: j.name, status: j.status, secs: Math.round(((j.ended ?? Date.now()) - j.started) / 1000), polled: j.polled }));
  const run = async (code) => {
    shown = [];
    const out = [];
    const log = console.log, err = console.error;
    console.log = console.info = (...a) => out.push(a.map((x) => (typeof x === "string" ? x : inspect(x))).join(" "));
    console.error = console.warn = console.log;
    try {
      let fn;
      try {
        fn = (0, eval)(`(async () => (${code}\n))`);  // a single expression: return its value
      } catch {
        // Statements: return the value of the last expression statement, if any.
        const lines = code.trimEnd().split("\n");
        const last = lines.pop();
        try {
          fn = (0, eval)(`(async () => { ${lines.join("\n")}\n return (${last.replace(/;\s*$/, "")}\n) })`);
        } catch {
          fn = (0, eval)(`(async () => { ${code}\n })`);
        }
      }
      const v = await fn();
      for (const x of [v].flat()) if (typeof x === "string" && IMG.test(x) && !shown.includes(x)) shown.push(x);
      if (v !== undefined) out.push(typeof v === "string" ? v : inspect(v, { depth: 4, colors: false }));
    } catch (e) {
      out.push(`Error: ${e?.stack ?? e}`);
    } finally {
      console.log = console.info = log;
      console.error = console.warn = err;
    }
    return out.join("\n") + "\n" + (shown.length ? `\u0001SHOW ${JSON.stringify(shown)}\n` : "");
  };
  Bun.listen({
    unix: SOCK,
    socket: {
      open(s) { s.data = ""; },
      data(s, d) {
        s.data += d.toString();
        const i = s.data.indexOf("\0");
        if (i < 0) return;
        run(s.data.slice(0, i)).then((r) => { s.write(r); s.end(); });
      },
    },
  });
} else {
  if (args[0] === "--stop" || args[0] === "--restart") {
    spawn("pkill", ["-f", "brepl --serv[e]"]).on("exit", () => { if (existsSync(SOCK)) unlinkSync(SOCK); });
    await Bun.sleep(300);
    if (args[0] === "--stop") process.exit(0);
    args.shift();
  }
  const code = args.length ? args.join(" ") : await new Response(Bun.stdin.stream()).text();
  if (!code.trim()) process.exit(0);
  const connect = () => new Promise((ok, bad) => {
    let buf = "";
    Bun.connect({
      unix: SOCK,
      socket: {
        open(s) { s.write(code + "\0"); },
        data(_, d) { buf += d.toString(); },
        close() { ok(buf); },
        error(_, e) { bad(e); },
        connectError(_, e) { bad(e); },
      },
    }).catch(bad);
  });
  let res;
  try {
    res = await connect();
  } catch {
    spawn(process.execPath, [import.meta.path, "--serve"], { detached: true, stdio: "ignore" }).unref();
    for (let i = 0; i < 50 && !existsSync(SOCK); i++) await Bun.sleep(50);
    res = await connect();
  }
  if (process.env.BREPL_RAW !== "1") res = res.replace(/\u0001SHOW (.*)\n/, (_, j) => JSON.parse(j).map((p) => `[image: ${p}]`).join("\n") + "\n");
  process.stdout.write(res);
  if (res.startsWith("Error:")) process.exit(1);
}

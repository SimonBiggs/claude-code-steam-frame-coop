#!/bin/bash
# deck-pair: pair every family Steam Deck that's asking for a devkit host (Developer Mode → pairing), give it an ssh
# alias <name>-deck, add it to ~/.config/duo-arena/decks and install the arcade (duo-deploy-deck). Safe to run often:
# already-paired Decks are skipped (Simon: "every kid in the family has a deck"). Run by hand when Decks are pairing.
KEY=~/.config/steamos-devkit/devkit_rsa
LIST=~/.config/duo-arena/decks
mkdir -p "$(dirname "$LIST")"; touch "$LIST"
avahi-browse -rtp _steamos-devkit._tcp 2>/dev/null | awk -F';' '$1=="=" && $3=="IPv4"{print $4" "$8" "$9}' | sort -u |
while read -r host ip port <&3; do
  name=${host%-steamdeck}; name=${name%-steam-deck}; name=${name%-deck}
  alias="$name-deck"; [ "$host" = steamdeck ] && alias="steamdeck-$(echo "$ip" | tr . -)"
  if ! grep -q "^Host $alias\$" ~/.ssh/config 2>/dev/null; then
    printf '\n# %s (devkit-paired %s by deck-pair): ssh %s\nHost %s\n    HostName %s.local\n    User deck\n    IdentityFile %s\n    ConnectTimeout 5\n    HostKeyAlias %s\n    StrictHostKeyChecking accept-new\n' \
      "$host" "$(date +%F)" "$alias" "$alias" "$host" "$KEY" "$host" >> ~/.ssh/config
    echo "added ssh alias $alias"
  fi
  if ! ssh -o BatchMode=yes -o ConnectTimeout=5 "$alias" true 2>/dev/null; then
    echo "pairing $host ($ip): accept the prompt on the Deck"
    timeout 90 curl -s -X POST --data-binary @"$KEY.pub" "http://$ip:$port/register" >/dev/null || continue
    for _ in 1 2 3 4 5 6; do ssh -o BatchMode=yes -o ConnectTimeout=5 "$alias" true 2>/dev/null && break; sleep 5; done
    ssh -o BatchMode=yes -o ConnectTimeout=5 "$alias" true 2>/dev/null || { echo "$host: not paired yet"; continue; }
    echo "paired $host"
  fi
  if ! grep -qx "$alias" "$LIST"; then
    echo "$alias" >> "$LIST"; echo "added $alias to the deploy list"
  fi
  # Installed (also when an earlier run was cut off between pairing and deploying).
  ssh -o BatchMode=yes "$alias" 'test -d ~/DuoArena/game' 2>/dev/null || duo-deploy-deck "$alias"
  # Its own screen recorder, installed but OFF: 5 s gamescopectl screenshots made gamescope glitch/crash on the TV
  # (2026-10-24). Start it by hand for a short look (systemctl --user start deck-screen-rec), then stop it.
  if ! ssh -o BatchMode=yes "$alias" 'cat ~/.local/bin/deck-screen-rec 2>/dev/null' | cmp -s - ~/.local/bin/deck-screen-rec; then
    scp -q ~/.local/bin/deck-screen-rec "$alias:/tmp/deck-screen-rec" && ssh -o BatchMode=yes "$alias" 'mkdir -p ~/.local/bin ~/.config/systemd/user &&
      install -m755 /tmp/deck-screen-rec ~/.local/bin/deck-screen-rec &&
      printf "[Unit]\nDescription=Rolling record of this Deck'"'"'s screen for Claude on the Steam Machine\n\n[Service]\nExecStart=%%h/.local/bin/deck-screen-rec\nNice=15\nRestart=always\nRestartSec=10\n\n[Install]\nWantedBy=default.target\n" > ~/.config/systemd/user/deck-screen-rec.service &&
      systemctl --user daemon-reload && systemctl --user disable --now deck-screen-rec >/dev/null 2>&1; true' &&
      echo "$alias: screen recorder installed"
  fi
  # In its Steam library for Gaming Mode (needs Steam running on the Deck; retried every run until it's there).
  ssh -o BatchMode=yes "$alias" 'grep -qa DuoArena ~/.local/share/Steam/userdata/*/config/shortcuts.vdf 2>/dev/null ||
    { pgrep -x steam >/dev/null && XDG_SESSION_TYPE=x11 steamos-add-to-steam ~/.local/share/applications/duo-arena.desktop >/dev/null 2>&1 && echo "added Living Room Arcade to the Steam library"; }' 2>/dev/null
done 3<&0 </dev/null  # ssh reads stdin: keep the Deck list on fd 3 or the first ssh swallows the rest
exit 0

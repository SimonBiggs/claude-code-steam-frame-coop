#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.12"
# dependencies = ["pillow", "numpy"]
# ///
"""gdev: run a Godot project in the background with hot reload and screen recording.

  gdev start [DIR]        install the bridge autoload and launch the game detached
  gdev run [DIR]          like start, but stays in the foreground until the game exits (for Steam); restarts
                          the game when IT asked for that (see RESTART below)
  gdev stop | status
  gdev restart [--hard]   soft: reload the scene in place; hard: relaunch the process
  gdev send CMD...        raw bridge command (pause, resume, record on|off, quit)
  gdev log [-n N] [-e]    tail the game log (-e: only errors/warnings/gdev lines)
  gdev shot [--screen]    capture the game now (or the whole desktop) and print the path
  gdev frames             show the range of recorded frames
  gdev at TIME [--span S] [--count N]
                          frames around TIME plus change images in one sheet; TIME is
                          now | -30s | 2m ago | 15:42 | 15:42:10 | unix epoch

The project is found from -C DIR, then the current directory upward, then the last one started.

RESTART (gdev run only). The launcher decides nothing; the game does. A game may write <project>/.dev/restart.json
(path also in env GDEV_RESTART_FILE; GDEV_SUPERVISED=1 says someone reads it):
  {"args": [...extra godot args], "env": {NAME: value}, "unset": [NAME...], "now": bool, "reason": "..."}
gdev run starts it again with those args / env when the game died of a crash signal (ABRT, SEGV, BUS, ILL, FPE: e.g.
SteamVR's vrclient.so aborting the game when vrserver dies, 2026-11-13) or exited any way with "now": true (the game
asked). No file, or a normal exit / SIGTERM, ends gdev run as before. Each start deletes the file (start unarmed);
more than 4 restarts in 2 minutes stops trying (said in the log and on the brepl channel, never quietly).
Tests: GDEV_GODOT (default: godot on PATH) and GDEV_GODOT_ARGS (e.g. "--headless") change how Godot is started.
"""
import argparse
import datetime as dt
import json
import os
import shlex
import re
import shutil
import signal
import subprocess
import sys
import time
from pathlib import Path

GDEV_HOME = Path.home() / ".local/share/gdev"
BRIDGE_SRC = GDEV_HOME / "bridge.gd"
LAST_FILE = Path.home() / ".cache/gdev/last"
AUTOLOAD_LINE = 'GDev="*res://addons/gdev/bridge.gd"'


# --- Project helpers ---------------------------------------------------------

def find_project(explicit: str | None) -> Path:
    if explicit:
        p = Path(explicit).expanduser().resolve()
        if (p / "project.godot").exists():
            return p
        sys.exit(f"gdev: no project.godot in {p}")
    for d in [Path.cwd(), *Path.cwd().parents]:
        if (d / "project.godot").exists():
            return d
    if LAST_FILE.exists():
        p = Path(LAST_FILE.read_text().strip())
        if (p / "project.godot").exists():
            return p
    sys.exit("gdev: no Godot project found (use -C DIR)")


def dev_dir(proj: Path) -> Path:
    d = proj / ".dev"
    d.mkdir(exist_ok=True)
    (d / ".gdignore").touch()
    return d


def pid_of(proj: Path) -> int | None:
    f = proj / ".dev/pid"
    if not f.exists():
        return None
    try:
        pid = int(f.read_text())
        os.kill(pid, 0)
        return pid
    except (ValueError, ProcessLookupError, PermissionError):
        return None


def _install_file(src: Path, dst: Path) -> None:
    """Copy src over dst, but never quietly over a project copy that differs AND is newer (someone's edit: a launch
    once silently undid an agent's addons/gdev fix, 2026-11-12): skip it with a warning (also to the brepl channel)."""
    if not src.exists() or (dst.exists() and dst.read_bytes() == src.read_bytes()):
        return
    if dst.exists() and dst.stat().st_mtime > src.stat().st_mtime:
        msg = (f"⚠ gdev install: NOT overwriting {dst}: it differs from the installed {src} and is newer (an edit?). "
               f"Copy it to {src.parent} if it's the new version, or delete it to take the installed one.")
        print(msg, file=sys.stderr)
        try:
            subprocess.run(["brepl", "--pipe", "gdev"], input=msg + "\n", text=True, timeout=5,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception as e:  # the warning above is already printed
            print(f"(gdev: couldn't post it to the brepl channel: {e})", file=sys.stderr)
        return
    shutil.copyfile(src, dst)


def install(proj: Path) -> None:
    dst = proj / "addons/gdev/bridge.gd"
    dst.parent.mkdir(parents=True, exist_ok=True)
    _install_file(BRIDGE_SRC, dst)
    # caption.gd: "Claude:" captions; control.gd: the offscreen test control server (godot.ts). Both made by the bridge.
    # gdev_main.gd: the bridge logic itself (bridge.gd is only a frozen loader; a project's core/dev/gdev_main.gd wins).
    for extra in ("caption.gd", "control.gd", "gdev_main.gd"):
        _install_file(GDEV_HOME / extra, dst.parent / extra)
    cfg = proj / "project.godot"
    text = cfg.read_text()
    if AUTOLOAD_LINE not in text:
        if "[autoload]" in text:
            text = text.replace("[autoload]\n", f"[autoload]\n\n{AUTOLOAD_LINE}\n", 1)
        else:
            text = text.rstrip() + f"\n\n[autoload]\n\n{AUTOLOAD_LINE}\n"
        cfg.write_text(text)
    dev_dir(proj)


def send(proj: Path, line: str) -> None:
    if not pid_of(proj):
        sys.exit("gdev: game is not running (gdev start)")
    cmd = dev_dir(proj) / "cmd"
    tmp = cmd.with_suffix(".tmp")
    existing = cmd.read_text() if cmd.exists() else ""
    tmp.write_text(existing + line + "\n")
    tmp.replace(cmd)


# --- Commands ----------------------------------------------------------------

CRASH_SIGNALS = {signal.SIGABRT, signal.SIGSEGV, signal.SIGBUS, signal.SIGILL, signal.SIGFPE}
RESTART_LIMIT = 4  # restarts allowed ...
RESTART_WINDOW = 120.0  # ... in this many seconds


def restart_file(proj: Path) -> Path:
    return dev_dir(proj) / "restart.json"


def _say(proj: Path, msg: str) -> None:
    """A supervisor line: printed, in the game log and on the brepl channel (never a quiet restart)."""
    print(msg, file=sys.stderr)
    try:
        with open(dev_dir(proj) / "game.log", "a") as f:
            f.write(msg + "\n")
    except OSError:
        pass
    try:
        subprocess.run(["brepl", "--pipe", "gdev"], input=msg + "\n", text=True, timeout=5,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass  # printed and logged above


def _restart_spec(proj: Path, code: int) -> dict | None:
    """What the game asked for (restart.json), if this exit should restart it; None = gdev run ends."""
    f = restart_file(proj)
    try:
        spec = json.loads(f.read_text())
    except (OSError, ValueError):
        return None
    if not isinstance(spec, dict):
        return None
    crashed = code < 0 and -code in CRASH_SIGNALS
    return spec if crashed or spec.get("now") else None


def cmd_run(proj: Path, args) -> None:
    """Foreground launch (for Steam shortcuts): replaces any running instance and waits for the game, starting it
    again when the game asked for that (RESTART in the help)."""
    if pid_of(proj):
        cmd_stop(proj, args)
    args.wait = False
    stopping = {"sig": 0}
    game = {"pid": 0}

    def forward(sig, _frame):  # Steam / a terminal stopping us stops the game too (and no restart)
        stopping["sig"] = sig
        if game["pid"]:
            try:
                os.killpg(game["pid"], signal.SIGTERM)
            except ProcessLookupError:
                pass

    for s in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(s, forward)
    restarts: list[float] = []
    extra_args: list[str] = []
    extra_env: dict = {}
    unset: list = []
    while True:
        restart_file(proj).unlink(missing_ok=True)  # every start begins unarmed
        p = cmd_start(proj, args, extra_args, extra_env, unset)
        if p is None:
            return
        game["pid"] = p.pid
        if stopping["sig"]:  # stopped while it was starting
            forward(stopping["sig"], None)
        code = p.wait()
        if stopping["sig"]:
            sys.exit(code)
        spec = _restart_spec(proj, code)
        if spec is None:
            sys.exit(code)
        now = time.time()
        restarts = [t for t in restarts if now - t < RESTART_WINDOW] + [now]
        how = f"crashed (signal {signal.Signals(-code).name})" if code < 0 else f"exited ({code})"
        if len(restarts) > RESTART_LIMIT:
            _say(proj, f"[gdev] {proj.name} {how}: NOT restarting, {len(restarts) - 1} restarts in "
                       f"{RESTART_WINDOW:.0f} s already ({spec.get('reason', '')})")
            sys.exit(code)
        extra_args = [str(a) for a in spec.get("args", [])]
        extra_env = {str(k): str(v) for k, v in dict(spec.get("env", {})).items()}
        unset = [str(k) for k in spec.get("unset", [])]
        _say(proj, f"[gdev] {proj.name} {how}; restarting as it asked: {spec.get('reason', '')} "
                   f"args={extra_args} env={extra_env} unset={unset}")


def cmd_start(proj: Path, args, extra_args: list | None = None, extra_env: dict | None = None,
              unset: list | None = None) -> subprocess.Popen | None:
    if pid := pid_of(proj):
        print(f"already running (pid {pid}); use gdev restart [--hard]")
        return None
    install(proj)
    d = dev_dir(proj)
    log = d / "game.log"
    if log.exists():
        log.replace(d / "game.log.1")
    godot = os.environ.get("GDEV_GODOT") or shutil.which("godot") or str(Path.home() / ".local/bin/godot")
    env = dict(os.environ)
    for k in unset or []:
        env.pop(k, None)
    env.update(extra_env or {})
    env["GDEV_SUPERVISED"] = "1" if args.cmd == "run" else ""
    env["GDEV_RESTART_FILE"] = str(restart_file(proj))
    cmd = [godot, *shlex.split(os.environ.get("GDEV_GODOT_ARGS", "")), "--path", str(proj), *(extra_args or [])]
    with open(log, "w") as out:
        p = subprocess.Popen(cmd, stdout=out, stderr=subprocess.STDOUT, env=env,
                             stdin=subprocess.DEVNULL, start_new_session=True)
    (d / "pid").write_text(str(p.pid))
    LAST_FILE.parent.mkdir(parents=True, exist_ok=True)
    LAST_FILE.write_text(str(proj))
    for _ in range(50):
        time.sleep(0.2)
        if p.poll() is not None:
            if args.cmd == "run":
                break  # cmd_run decides (a crash at start may still be a restart the game asked for)
            print(log.read_text()[-3000:])
            sys.exit(f"gdev: game exited with code {p.returncode}")
        if "bridge ready" in log.read_text(errors="replace"):
            break
    print(f"started {proj.name} (pid {p.pid}), log: {log}")
    return p


def cmd_stop(proj: Path, args) -> None:
    pid = pid_of(proj)
    if not pid:
        print("not running")
        return
    os.killpg(pid, signal.SIGTERM)
    for _ in range(25):
        time.sleep(0.2)
        if not pid_of(proj):
            break
    else:
        os.killpg(pid, signal.SIGKILL)
    print("stopped")


def cmd_restart(proj: Path, args) -> None:
    if args.hard or not pid_of(proj):
        cmd_stop(proj, args)
        cmd_start(proj, args)
    else:
        send(proj, "restart")
        print("scene restarted")


def cmd_status(proj: Path, args) -> None:
    pid = pid_of(proj)
    print(f"{proj.name}: {'running, pid %d' % pid if pid else 'not running'}")
    cmd_frames(proj, args)


def cmd_send(proj: Path, args) -> None:
    send(proj, " ".join(args.words))


def cmd_log(proj: Path, args) -> None:
    log = proj / ".dev/game.log"
    if not log.exists():
        sys.exit("no log yet")
    lines = log.read_text(errors="replace").splitlines()
    if args.errors:
        keep = re.compile(r"ERROR|WARNING|SCRIPT|Parse Error|at: |\[gdev|backtrace|^\s+\[\d+\]")
        lines = [l for l in lines if keep.search(l)]
    print("\n".join(lines[-args.n:]))


def cmd_shot(proj: Path, args) -> None:
    d = dev_dir(proj)
    if args.screen:
        raw = d / "screen.png"
        raw.unlink(missing_ok=True)
        # ONE shot via tv-shot: gamescopectl in Gaming Mode, spectacle only in Desktop Mode (spectacle crashes in gamescope)
        r = subprocess.run(["tv-shot", str(raw)], capture_output=True, text=True)
        if r.returncode:
            sys.exit(f"gdev: screen shot failed: {r.stderr.strip()}")
        from PIL import Image
        img = Image.open(raw).convert("RGB")
        img.thumbnail((1600, 1600))
        out = d / "screen.jpg"
        img.save(out, quality=85)
        print(out)
        return
    out = d / "shot.jpg"
    out.unlink(missing_ok=True)
    send(proj, f"shot {args.width}")
    for _ in range(50):
        time.sleep(0.1)
        if out.exists():
            print(out)
            return
    sys.exit("gdev: no screenshot arrived (is the window minimized?)")


def frame_list(proj: Path) -> list[tuple[float, Path]]:
    fdir = proj / ".dev/frames"
    if not fdir.exists():
        return []
    return sorted((int(p.stem) / 1000.0, p) for p in fdir.glob("*.jpg") if p.stem.isdigit())


def fmt_t(t: float) -> str:
    return dt.datetime.fromtimestamp(t).strftime("%H:%M:%S.%f")[:-4]


def cmd_frames(proj: Path, args) -> None:
    fl = frame_list(proj)
    if not fl:
        print("no frames recorded")
        return
    print(f"{len(fl)} frames, {fmt_t(fl[0][0])} .. {fmt_t(fl[-1][0])} "
          f"({(fl[-1][0] - fl[0][0]) / 60:.1f} min)")


def parse_time(s: str) -> float:
    s = s.strip().lower()
    now = time.time()
    if s == "now":
        return now
    m = re.fullmatch(r"-?(\d+(?:\.\d+)?)\s*(s|sec|m|min|h)?(?:\s*ago)?", s)
    if m and (s.startswith("-") or "ago" in s or m.group(2)):
        n = float(m.group(1))
        unit = {"m": 60, "min": 60, "h": 3600}.get(m.group(2) or "s", 1)
        return now - n * unit
    if re.fullmatch(r"\d{9,}(\.\d+)?", s):
        n = float(s)
        return n / 1000.0 if n > 1e11 else n
    m = re.fullmatch(r"(\d{1,2}):(\d{2})(?::(\d{2})(?:\.(\d+))?)?", s)
    if m:
        today = dt.datetime.now()
        t = today.replace(hour=int(m.group(1)), minute=int(m.group(2)), second=int(m.group(3) or 0),
                          microsecond=int((m.group(4) or "0").ljust(6, "0")[:6]))
        if t > today + dt.timedelta(minutes=1):
            t -= dt.timedelta(days=1)
        return t.timestamp()
    return dt.datetime.fromisoformat(s).timestamp()


def cmd_at(proj: Path, args) -> None:
    import numpy as np
    from PIL import Image, ImageDraw, ImageFont

    t = parse_time(args.time)
    fl = frame_list(proj)
    if not fl:
        sys.exit("no frames recorded")
    window = [f for f in fl if abs(f[0] - t) <= args.span]
    if len(window) < 2:
        nearest = min(fl, key=lambda f: abs(f[0] - t))
        if abs(nearest[0] - t) > max(args.span, 5):
            sys.exit(f"no frames near {fmt_t(t)}; recorded {fmt_t(fl[0][0])} .. {fmt_t(fl[-1][0])}")
        i = fl.index(nearest)
        window = fl[max(0, i - 1): i + 2]
    # Pick evenly spaced frames, always including the one closest to t.
    if len(window) > args.count:
        idx = {round(k * (len(window) - 1) / (args.count - 1)) for k in range(args.count)}
        closest = min(range(len(window)), key=lambda k: abs(window[k][0] - t))
        idx = sorted(idx | {closest})
        while len(idx) > args.count:
            drop = min((k for k in idx if k != closest), key=lambda k: abs(window[k][0] - t))
            idx.remove(drop)
        window = [window[k] for k in idx]

    tile_w = 640
    imgs = []
    for _, p in window:
        im = Image.open(p).convert("RGB")
        imgs.append(im.resize((tile_w, round(im.height * tile_w / im.width))))
    tile_h = imgs[0].height
    arrs = [np.asarray(im, dtype=np.int16) for im in imgs]

    def change_image(a, b):
        diff = np.abs(b - a).sum(axis=2)
        mask = diff > 45
        gray = (np.asarray(Image.fromarray(b.astype(np.uint8)).convert("L"), dtype=np.float32) * 0.35)
        out = np.stack([gray] * 3, axis=2)
        strength = np.clip(diff / 200.0, 0.35, 1.0)[mask]
        out[mask] = np.stack([255 * strength, 40 * strength, 200 * strength], axis=1)
        return Image.fromarray(out.astype(np.uint8)), 100.0 * mask.mean()

    font = ImageFont.load_default(size=20)
    head = 30
    rows = len(imgs) + 1
    sheet = Image.new("RGB", (tile_w * 2, rows * (tile_h + head)), (20, 20, 24))
    draw = ImageDraw.Draw(sheet)
    report = []
    for i, (ft, _) in enumerate(window):
        y = i * (tile_h + head)
        mark = "  <== target" if ft == min(window, key=lambda f: abs(f[0] - t))[0] else ""
        draw.text((8, y + 4), f"{fmt_t(ft)}  ({ft - t:+.1f}s){mark}", fill=(255, 255, 255), font=font)
        sheet.paste(imgs[i], (0, y + head))
        if i > 0:
            ci, pct = change_image(arrs[i - 1], arrs[i])
            draw.text((tile_w + 8, y + 4), f"changed since previous: {pct:.1f}%", fill=(255, 120, 220), font=font)
            sheet.paste(ci, (tile_w, y + head))
            report.append(f"{fmt_t(window[i - 1][0])} -> {fmt_t(ft)}: {pct:.1f}% of pixels changed")
    y = len(imgs) * (tile_h + head)
    ci, pct = change_image(arrs[0], arrs[-1])
    draw.text((8, y + 4), f"first -> last ({window[-1][0] - window[0][0]:.1f}s): {pct:.1f}% changed",
              fill=(255, 120, 220), font=font)
    sheet.paste(ci, (0, y + head))
    sheet.paste(imgs[-1], (tile_w, y + head))
    draw.text((tile_w + 8, y + 4), "last frame", fill=(255, 255, 255), font=font)

    out = dev_dir(proj) / "at.jpg"
    sheet.save(out, quality=85)
    print(f"target {fmt_t(t)}; {len(window)} frames")
    print("\n".join(report))
    print("frames:\n" + "\n".join(f"  {fmt_t(ft)}  {p}" for ft, p in window))
    print(out)


def main() -> None:
    ap = argparse.ArgumentParser(prog="gdev", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("-C", dest="project", help="project directory")
    sub = ap.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("start"); s.add_argument("dir", nargs="?")
    s = sub.add_parser("run"); s.add_argument("dir", nargs="?")
    sub.add_parser("stop")
    s = sub.add_parser("restart"); s.add_argument("--hard", action="store_true")
    sub.add_parser("status")
    s = sub.add_parser("send"); s.add_argument("words", nargs="+")
    s = sub.add_parser("log"); s.add_argument("-n", type=int, default=40); s.add_argument("-e", "--errors", action="store_true")
    s = sub.add_parser("shot"); s.add_argument("--screen", action="store_true"); s.add_argument("--width", type=int, default=1600)
    sub.add_parser("frames")
    s = sub.add_parser("at"); s.add_argument("time")
    s.add_argument("--span", type=float, default=3.0, help="seconds either side (default 3)")
    s.add_argument("--count", type=int, default=5, help="max frames in the sheet (default 5)")
    args = ap.parse_args()
    proj = find_project(getattr(args, "dir", None) or args.project)
    globals()["cmd_" + args.cmd](proj, args)


if __name__ == "__main__":
    main()

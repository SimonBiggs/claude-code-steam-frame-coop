#!/usr/bin/env python3
"""claude-wake: LOCAL wake-up for the main Claude conversation (no cloud needed).

Cloud send_later / routines are refused for the main conversation (it is a Remote Control session), so when the
usage limit hits, nothing would resume it after the reset. This wakes it from the machine itself: a headless
one-shot "claude -p" sends a cross-session message to the main session's UNIX socket
(/run/user/1000/cc-socks/<pid>.sock), which is delivered into the conversation even when it is idle.

  claude-wake now "TEXT"         send TEXT into the main conversation right now (refused while a usage limit is
                                 active, unless --force)
  claude-wake after-reset        if a usage window is at its limit (>= 95 %) or the main session's last turn ended on
                                 a rate-limit error: wait until the reset + 2 min, then send the standard resume message
  claude-wake after-reset --check
                                 same, but never waits: arms (records) the wake-up and exits; sends only once the time
                                 has come. claude-watchdog runs this every 2 minutes, so nothing has to stay running.
  claude-wake keep-going --check if the main conversation has been idle >= 20 min, no subagent transcript or brepl
                                 job wrote in 20 min, usage allows (claude-pace recommends >= 1 agent or the weekly
                                 window is at/below its ideal pace; never at >= 90 %) and no nudge in 45 min: send the
                                 keep-improving message. Run by claude-watchdog every 2 min.
  claude-wake status             what is armed / last fired / keep-going decision, plus the log tail
Options: --dry-run (decide and print, never send). Env: CLAUDE_WAKE_USAGE (usage.json path),
CLAUDE_WAKE_SESSION (session jsonl path), CLAUDE_WAKE_STATE (state file), CLAUDE_WAKE_NOW (fake epoch, for tests),
CLAUDE_WAKE_SUBAGENTS (subagent dir), CLAUDE_WAKE_CHANNEL (brepl channel), CLAUDE_WAKE_PACE_OUT (fake claude-pace output),
CLAUDE_WAKE_FAKE_SEND (tests: file whose text is used as the headless claude result instead of really sending),
CLAUDE_WAKE_NO_INHIBIT=1 (don't hold the sleep inhibitor). Regression test: claude-wake-test.
Fires once per reset (state file ~/.claude/wake-state.json) and never if the main session has had a real assistant
turn since the reset. Never sends anything while a usage limit is active (armed future reset, a recent limit error in
the main transcript, a window >= 95 %, or a send that just failed with 429 -> "blocked_until" in the state file).
While a wake-up is pending (due within 6 h) it holds a logind sleep inhibitor (systemd user unit claude-wake-inhibit),
because Steam auto-suspends the machine after 1 h without input (Sun 25 Oct: suspended 20:00, the 21:02 wake never ran).
Log: ~/.claude/wake.log
"""
import json, os, subprocess, sys, time, glob

HOME = os.path.expanduser("~")
USAGE = os.environ.get("CLAUDE_WAKE_USAGE", f"{HOME}/.claude/usage.json")
STATE = os.environ.get("CLAUDE_WAKE_STATE", f"{HOME}/.claude/wake-state.json")
LOG = os.environ.get("CLAUDE_WAKE_LOG", os.path.join(os.path.dirname(STATE), "wake.log"))
SOCKS = "/run/user/1000/cc-socks"
LIMIT_PCT = 95
GRACE = 120  # seconds after the reset before waking
RESUME = ("Usage window has reset. Resume: re-arm the brepl channel watch, run claude-pace, resume every agent that "
          "stopped on the limit with SendMessage (their work is saved), restart the continuous deploy steward if it "
          "stopped, land tested branches, then give Simon a short status.")
DRY = "--dry-run" in sys.argv


def now():
    return float(os.environ.get("CLAUDE_WAKE_NOW") or time.time())


def log(msg):
    line = f"{time.strftime('%Y-%m-%dT%H:%M:%S%z')} {msg}"
    print(line)
    if not DRY:
        with open(LOG, "a") as f:
            f.write(line + "\n")


def hm(t):
    return time.strftime("%a %H:%M", time.localtime(t))


def session_file():
    if os.environ.get("CLAUDE_WAKE_SESSION"):
        return os.environ["CLAUDE_WAKE_SESSION"]
    sid = open(f"{HOME}/.claude/main-session").read().strip()
    return f"{HOME}/.claude/projects/-home-deck/{sid}.jsonl"


def main_pid():
    r = subprocess.run([f"{HOME}/.local/bin/claude-main", "--running"], capture_output=True, text=True)
    p = r.stdout.strip().splitlines()
    return p[0] if r.returncode == 0 and p and p[0].isdigit() else None


def load(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except Exception:
        return default


def save_state(s):
    if DRY:
        return
    tmp = STATE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(s, f, indent=1)
    os.replace(tmp, STATE)


def epoch(v):
    if v is None:
        return None
    if isinstance(v, (int, float)):
        return v / 1000 if v > 1e12 else float(v)
    try:
        from datetime import datetime
        return datetime.fromisoformat(str(v).replace("Z", "+00:00")).timestamp()
    except Exception:
        return None


def tail_entries(path, kinds=("assistant", "user")):
    """Top-level transcript entries of the given types from the transcript's tail (oldest first)."""
    try:
        with open(path, "rb") as f:
            f.seek(0, 2)
            size = f.tell()
            f.seek(max(0, size - 4_000_000))
            lines = f.read().decode("utf-8", "replace").splitlines()
    except OSError:
        return []
    out = []
    for line in lines:
        if not any(f'"type":"{k}"' in line or f'"type": "{k}"' in line for k in kinds):
            continue
        try:
            e = json.loads(line)
        except Exception:
            continue
        if e.get("type") in kinds and not e.get("isSidechain"):
            out.append(e)
    return out


def last_assistant(path):
    """The main session's last top-level assistant entry (from the transcript's tail)."""
    a = tail_entries(path, ("assistant",))
    return a[-1] if a else None


def real_assistant(e):
    """A real model turn: an assistant entry that is not an API error / synthetic message."""
    m = e.get("message") or {}
    return (e.get("type") == "assistant" and not e.get("isApiErrorMessage") and not e.get("apiError")
            and m.get("model") != "<synthetic>")


def human_prompt(e):
    """Something Simon typed (not a task-notification, tool result or injected system text)."""
    if e.get("type") != "user" or e.get("isMeta") or (e.get("origin") or {}).get("kind") not in (None, "human", "user"):
        return False
    c = (e.get("message") or {}).get("content")
    return isinstance(c, str) and not c.lstrip().startswith("<")


def last_real_turn(path, humans=False):
    """Epoch of the newest real assistant turn (and, with humans=True, typed prompt) in the main transcript."""
    best = None
    for e in tail_entries(path):
        if real_assistant(e) or (humans and human_prompt(e)):
            t = epoch(e.get("timestamp"))
            if t and (best is None or t > best):
                best = t
    return best


def limit_error(e):
    """(reset epoch, kind) if this entry is a usage/rate-limit error, else None."""
    if not e:
        return None
    if not (e.get("isApiErrorMessage") and (e.get("error") == "rate_limit" or e.get("apiErrorStatus") == 429
                                            or e.get("apiError") == "usage_limit_reached")):
        return None
    q = e.get("quotaLimits") or (e.get("apiErrorParams") or {}).get("rate_limit_info") or {}
    r = epoch(q.get("resetsAt"))
    if r is None:  # fall back to the usage file
        u = load(USAGE, {}).get("rate_limits", {})
        rs = [epoch(w.get("resets_at")) for w in u.values() if isinstance(w, dict) and (w.get("used_percentage") or 0) >= LIMIT_PCT]
        rs = [x for x in rs if x]
        r = max(rs) if rs else None
    return (r, q.get("rateLimitType") or "rate limit") if r else None


def parse_reset(text):
    """Reset epoch from a usage-limit error: a resetsAt field, else "resets 9pm (Europe/Dublin)" / "resets Oct 27, 3:30am"."""
    import re
    m = re.search(r'"resets_?[aA]t"\s*:\s*"?(\d{9,13})', text)
    if m:
        return epoch(int(m.group(1)))
    m = re.search(r"resets\s+(?:([A-Z][a-z]{2})\s+(\d{1,2}),?\s+)?(?:at\s+)?(\d{1,2})(?::(\d{2}))?\s*([ap]m)\s*(?:\(([^)]+)\))?",
                  text, re.I)
    if not m:
        return None
    from datetime import datetime, timedelta
    try:
        from zoneinfo import ZoneInfo
        tz = ZoneInfo(m.group(6)) if m.group(6) else None
    except Exception:
        tz = None
    cur = datetime.fromtimestamp(now(), tz) if tz else datetime.fromtimestamp(now())
    h = int(m.group(3)) % 12 + (12 if m.group(5).lower() == "pm" else 0)
    t = cur.replace(hour=h, minute=int(m.group(4) or 0), second=0, microsecond=0)
    if m.group(1):
        try:
            mon = datetime.strptime(m.group(1), "%b").month
            t = t.replace(month=mon, day=int(m.group(2)))
            if t.timestamp() < now() - 86400:
                t = t.replace(year=t.year + 1)
        except ValueError:
            pass
    elif t.timestamp() <= now():
        t += timedelta(days=1)
    return t.timestamp()


def limit_until():
    """(epoch, why) while a usage limit is active (nothing may be sent until then), else None."""
    t = now()
    s = load(STATE, {})
    found = []
    if s.get("blocked_until", 0) > t:
        found.append((s["blocked_until"], "a send failed with 429 usage_limit_reached"))
    if s.get("armed") and s["armed"] != s.get("fired") and s["armed"] > t:
        found.append((s["armed"], s.get("why") or "wake-up armed for the reset"))
    try:
        ents = tail_entries(session_file())
    except Exception:
        ents = []
    for e in reversed(ents):
        if real_assistant(e):
            break  # the session worked after any earlier limit error
        err = limit_error(e) if e.get("type") == "assistant" else None
        if err and err[0] > t:
            found.append((err[0], f"main session hit its {err[1]} limit"))
            break
    for name, w in load(USAGE, {}).get("rate_limits", {}).items():
        if isinstance(w, dict) and (w.get("used_percentage") or 0) >= LIMIT_PCT and (epoch(w.get("resets_at")) or 0) > t:
            found.append((epoch(w["resets_at"]), f"{name} window at {w['used_percentage']}%"))
    return max(found) if found else None


INHIBIT_UNIT = "claude-wake-inhibit"


def inhibit(until):
    """Hold (or with until=None release) a logind sleep block until `until`, in its own user unit so it outlives
    claude-watchdog.service. Steam's 1 h idle auto-suspend (a deck-user Suspend call) is refused while it is held."""
    if DRY or os.environ.get("CLAUDE_WAKE_NO_INHIBIT") or os.environ.get("CLAUDE_WAKE_FAKE_SEND"):
        return
    s = load(STATE, {})
    active = subprocess.run(["systemctl", "--user", "is-active", "--quiet", INHIBIT_UNIT]).returncode == 0
    if until is None:
        if active:
            subprocess.run(["systemctl", "--user", "stop", INHIBIT_UNIT], capture_output=True)
            log("released the sleep inhibitor")
        if "inhibit_until" in s:
            s.pop("inhibit_until")
            save_state(s)
        return
    if active and abs(s.get("inhibit_until", 0) - until) < 300:
        return
    if active:
        subprocess.run(["systemctl", "--user", "stop", INHIBIT_UNIT], capture_output=True)
    secs = int(until - now())
    if secs <= 0:
        return
    r = subprocess.run(["systemd-run", "--user", "--quiet", "--collect", f"--unit={INHIBIT_UNIT}",
                        "systemd-inhibit", "--what=sleep", "--mode=block", "--who=claude-wake",
                        f"--why=Claude wake-up pending for {hm(until - 900)} (usage-limit reset)",
                        "sleep", str(secs)], capture_output=True, text=True)
    if r.returncode == 0:
        s["inhibit_until"] = until
        save_state(s)
        log(f"holding a sleep inhibitor until {hm(until)} so the machine stays awake for the wake-up")
    else:
        log(f"could not start the sleep inhibitor: {(r.stderr or r.stdout).strip()[:200]}")


def send(text, force=False):
    if not force:
        lim = limit_until()
        if lim:
            log(f"not sending (usage limit active until {hm(lim[0])}: {lim[1]}): {text[:60]!r}")
            return False
    fake = os.environ.get("CLAUDE_WAKE_FAKE_SEND")
    pid = "fake" if fake else main_pid()
    if not pid:
        log("main Claude is not running (claude-watchdog restarts it); not sending")
        return False
    sock = f"{SOCKS}/{pid}.sock"
    if not fake and not os.path.exists(sock):
        log(f"no socket {sock}; not sending")
        return False
    if DRY:
        print(f"DRY RUN: would send to {sock}: {text}")
        return True
    prompt = (f"Use the SendMessage tool exactly once, with to set to \"uds:{sock}\" and message set to the exact text "
              f"between the markers (verbatim, nothing added).\n<<<\n{text}\n>>>\nThen stop and reply DONE.")
    os.makedirs(f"{HOME}/GodotProjects", exist_ok=True)
    try:
        r = subprocess.CompletedProcess([], 0, open(fake).read(), "") if fake else subprocess.run([f"{HOME}/.local/bin/claude", "-p", "--model", "haiku", "--strict-mcp-config",
                            "--tools", "SendMessage", "--allowedTools", "SendMessage", "--output-format", "json", prompt],
                           cwd=f"{HOME}/GodotProjects", capture_output=True, text=True, timeout=300)
    except subprocess.TimeoutExpired:
        log("headless send timed out")
        return False
    out = (r.stdout + r.stderr).strip()
    try:
        res = json.loads(r.stdout)
        ok = not res.get("is_error") and res.get("num_turns", 0) >= 2 and not res.get("permission_denials")
    except Exception:
        res, ok = None, False
    log(f"sent to pid {pid}: {'ok' if ok else 'FAILED'}: {text[:80]!r}" + ("" if ok else f" | {out[-400:]}"))
    if not ok and ("usage_limit_reached" in out or '"api_error_status":429' in out or "hit your" in out):
        b = parse_reset(out) or now() + 1800  # unparseable reset: back off 30 min
        st = load(STATE, {})
        st["blocked_until"] = b
        save_state(st)
        log(f"usage limit active: no more sends until {hm(b)}")
    return ok


def decide():
    """Work out whether a wake-up is needed: returns (reset epoch, why) or None."""
    s = load(STATE, {})
    sess = session_file()
    e = last_assistant(sess)
    err = limit_error(e)
    if err:
        return err[0], f"main session stopped on a {err[1]} limit"
    u = load(USAGE, {}).get("rate_limits", {})
    hits = []
    for name, w in u.items():
        if isinstance(w, dict) and (w.get("used_percentage") or 0) >= LIMIT_PCT and epoch(w.get("resets_at")):
            hits.append((epoch(w["resets_at"]), f"{name} window at {w['used_percentage']}%"))
    hits = [h for h in hits if h[0] + GRACE > now() - 6 * 3600]
    b = s.get("blocked_until")
    if b and b != s.get("fired") and b + GRACE > now() - 6 * 3600:
        hits.append((b, "a send failed with 429 usage_limit_reached"))
    if hits:
        return max(hits)  # the later reset is the one that actually frees requests
    if s.get("armed") and s["armed"] != s.get("fired"):  # armed earlier; usage file has since dropped (reset happened)
        return s["armed"], s.get("why", "armed earlier")
    return None


def busy(reset):
    """The main conversation is already going again: a REAL assistant turn (not a limit error, not a task-notification
    or system line someone appended to the transcript) is timestamped after the reset."""
    t = last_real_turn(session_file())
    return bool(t and t > reset)


def after_reset(check):
    d = decide()
    s = load(STATE, {})
    if not d:
        print("no wake-up needed (no window at its limit, last turn not a rate-limit error)")
        return 0
    reset, why = d
    if s.get("fired") and abs(s["fired"] - reset) < 60:
        print(f"already woke the session for the {hm(reset)} reset")
        inhibit(None)
        return 0
    if s.get("armed") != reset:
        s.update(armed=reset, why=why, armed_at=now())
        save_state(s)
        log(f"local wake-up armed for {hm(reset + GRACE)} ({why})")
    due = reset + GRACE
    if due - now() < 6 * 3600 and now() < due + 3600:
        inhibit(max(due, now()) + 900)  # keep the machine awake (Steam idle-suspends after 1 h) until the wake-up
    if now() < due:
        if check:
            print(f"armed for {hm(due)} ({why}); not due yet")
            return 0
        print(f"waiting until {hm(due)} ({why})")
        while now() < due:
            time.sleep(min(60, max(1, due - now())))
    if now() - s.get("last_fail", 0) < 600:
        print("last send failed under 10 min ago; retrying later")
        return 0
    if busy(reset):
        log(f"reset {hm(reset)} passed and the main session is already working; no wake-up needed")
        s.update(fired=reset, fired_at=now(), result="skipped (busy)")
        save_state(s)
        inhibit(None)
        return 0
    ok = send(RESUME)
    s = load(STATE, {})  # send() may have recorded blocked_until
    if ok:
        s.update(fired=reset, fired_at=now(), result="sent")
        save_state(s)
        inhibit(None)
        return 0
    s["failures"] = s.get("failures", 0) + 1
    s["last_fail"] = now()
    save_state(s)
    return 1

# ---- keep-going: nudge the idle main conversation to start the next improvement (Simon: "please don't stop") ----
KEEP_IDLE = 20 * 60  # main transcript, subagent transcripts and brepl jobs all quiet this long
KEEP_EVERY = 45 * 60  # at most one nudge per 45 min
KEEP_MAX_PCT = 90  # never when either window is at/above this
KEEP_GOING = ("Keep improving (Simon's standing rule: don't stop). No agents are running and the budget allows: run "
              "claude-pace, then start the next improvement agent(s) — deeper games with story + procedural generation "
              "(most-played first, per the TV/Deck logs), Dungeon Delve follow-ups, fixes for anything frustrating in "
              "the logs — and make sure the continuous deploy steward is running. Then tell Simon one line.")
CHANNEL = os.environ.get("CLAUDE_WAKE_CHANNEL", f"{HOME}/.cache/brepl/channel.jsonl")


def mtime(p):
    try:
        return os.stat(p).st_mtime
    except OSError:
        return 0.0


def active_subagent():
    """Newest subagent transcript of the main session written within KEEP_IDLE: (name, age secs) or None."""
    d = os.environ.get("CLAUDE_WAKE_SUBAGENTS") or (session_file()[:-len(".jsonl")] + "/subagents")
    best = None
    for f in glob.glob(f"{d}/*.jsonl"):
        age = now() - mtime(f)
        if age < KEEP_IDLE and (best is None or age < best[1]):
            best = (os.path.basename(f), age)
    return best


def active_job():
    """A brepl background-job channel entry from the last KEEP_IDLE: (source, age secs) or None.
    Entries carry only a local HH:MM:SS, so ages are taken modulo a day and only when the file itself is fresh."""
    if now() - mtime(CHANNEL) >= KEEP_IDLE:
        return None
    try:
        with open(CHANNEL, "rb") as f:
            f.seek(0, 2)
            f.seek(max(0, f.tell() - 200_000))
            lines = f.read().decode("utf-8", "replace").splitlines()
    except OSError:
        return None
    lt = time.localtime(now())
    tod = lt.tm_hour * 3600 + lt.tm_min * 60 + lt.tm_sec
    for line in reversed(lines):
        try:
            e = json.loads(line)
            h, m, sec = (int(x) for x in str(e.get("t", "")).split(":"))
        except Exception:
            continue
        age = (tod - (h * 3600 + m * 60 + sec)) % 86400
        if age >= KEEP_IDLE:
            break  # older entries only get older
        if str(e.get("source", "")).startswith("job"):
            return e["source"], age
    return None


def pace_info():
    """Parse claude-pace: {'rec': N, '5-hour': (used, ideal), 'weekly': (used, ideal)}."""
    import re
    out = os.environ.get("CLAUDE_WAKE_PACE_OUT")
    if out is None:
        try:
            out = subprocess.run([f"{HOME}/.local/bin/claude-pace"], capture_output=True, text=True, timeout=60).stdout
        except Exception:
            out = ""
    info = {}
    m = re.search(r"RECOMMENDED AGENTS:\s*(\d+)", out)
    if m:
        info["rec"] = int(m.group(1))
    for name in ("5-hour", "weekly"):
        m = re.search(rf"^{name}: (\d+(?:\.\d+)?)% used.*?ideal now (\d+(?:\.\d+)?)%", out, re.M)
        if m:
            info[name] = (float(m.group(1)), float(m.group(2)))
    return info


def keep_going_reason():
    """None if a nudge should go now, else why not."""
    s = load(STATE, {})
    last = s.get("keep_going_at", 0)
    if now() - last < KEEP_EVERY:
        return f"nudged {int((now() - last) / 60)} min ago (at most every {KEEP_EVERY // 60} min)"
    lim = limit_until()
    if lim:
        return f"usage limit active until {hm(lim[0])} ({lim[1]})"
    if s.get("armed") and s["armed"] != s.get("fired") and now() - s["armed"] < 6 * 3600:
        return f"after-reset wake-up pending for {hm(s['armed'] + GRACE)} (it sends the resume message)"
    if s.get("result") == "sent" and now() - s.get("fired_at", 0) < KEEP_IDLE:
        return f"after-reset wake-up sent {int((now() - s['fired_at']) / 60)} min ago"
    last_turn = last_real_turn(session_file(), humans=True) or 0
    idle = now() - last_turn
    if idle < KEEP_IDLE:
        return f"main session busy (last real turn {int(idle / 60)} min ago)"
    a = active_subagent()
    if a:
        return f"agent active ({a[0]} written {int(a[1] / 60)} min ago)"
    j = active_job()
    if j:
        return f"brepl job active ({j[0]} posted {int(j[1] / 60)} min ago)"
    u = load(USAGE, {}).get("rate_limits", {})
    for name, w in u.items():
        if isinstance(w, dict) and (w.get("used_percentage") or 0) >= KEEP_MAX_PCT:
            return f"{name} window at {w['used_percentage']}% (>= {KEEP_MAX_PCT}%)"
    p = pace_info()
    for name in ("5-hour", "weekly"):
        if name in p and p[name][0] >= KEEP_MAX_PCT:
            return f"{name} window at {p[name][0]:.0f}% (>= {KEEP_MAX_PCT}%)"
    if "rec" not in p:
        return "could not read claude-pace"
    wk = p.get("weekly")
    if p["rec"] >= 1:
        return None
    if wk and wk[0] <= wk[1]:
        return None
    return f"budget tight (claude-pace recommends 0 agents, weekly {wk[0]:.0f}% vs ideal {wk[1]:.0f}%)" if wk else \
        "budget tight (claude-pace recommends 0 agents)"


def keep_going(check):
    why = keep_going_reason()
    if why:
        print(f"keep-going: no nudge: {why}")
        return 0
    s = load(STATE, {})
    if now() - s.get("keep_going_fail", 0) < 600:
        print("keep-going: last send failed under 10 min ago; retrying later")
        return 0
    log("keep-going: main idle, no agents/jobs, budget allows -> nudging")
    if send(KEEP_GOING):
        s = load(STATE, {})
        s.update(keep_going_at=now(), keep_going_result="sent")
        save_state(s)
        return 0
    s = load(STATE, {})
    s["keep_going_fail"] = now()
    save_state(s)
    return 1


def main():
    a = [x for x in sys.argv[1:] if x not in ("--dry-run", "--force")]
    if not a or a[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    if a[0] == "now":
        return 0 if send(" ".join(a[1:]) or RESUME, force="--force" in sys.argv) else 1
    if a[0] == "after-reset":
        return after_reset("--check" in a)
    if a[0] == "keep-going":
        return keep_going("--check" in a)
    if a[0] == "status":
        s = load(STATE, {})
        for k in ("armed", "fired"):
            if s.get(k):
                print(f"{k}: reset {hm(s[k])} (wake {hm(s[k] + GRACE)})")
        if s.get("keep_going_at"):
            print(f"last keep-going nudge: {hm(s['keep_going_at'])} ({s.get('keep_going_result')})")
        lim = limit_until()
        print(f"usage limit: {'active until ' + hm(lim[0]) + ' (' + lim[1] + ')' if lim else 'none active'}")
        print(f"keep-going now: {keep_going_reason() or 'would nudge'}")
        print(json.dumps(s))
        try:
            print("--- " + LOG + " (last 10)")
            print("".join(open(LOG).readlines()[-10:]), end="")
        except OSError:
            pass
        return 0
    print(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main())

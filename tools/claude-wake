#!/usr/bin/env python3
"""claude-wake: LOCAL wake-up for the main Claude conversation (no cloud needed).

Cloud send_later / routines are refused for the main conversation (it is a Remote Control session), so when the
usage limit hits, nothing would resume it after the reset. This wakes it from the machine itself: a headless
one-shot "claude -p" sends a cross-session message to the main session's UNIX socket
(/run/user/1000/cc-socks/<pid>.sock), which is delivered into the conversation even when it is idle.

  claude-wake now "TEXT"         send TEXT into the main conversation right now
  claude-wake after-reset        if a usage window is at its limit (>= 95 %) or the main session's last turn ended on
                                 a rate-limit error: wait until the reset + 2 min, then send the standard resume message
  claude-wake after-reset --check
                                 same, but never waits: arms (records) the wake-up and exits; sends only once the time
                                 has come. claude-watchdog runs this every 2 minutes, so nothing has to stay running.
  claude-wake keep-going --check if the main conversation has been idle >= 20 min, no subagent transcript or brepl
                                 job wrote in 20 min, usage allows (claude-pace recommends >= 1 agent or the weekly
                                 window is at/below its ideal pace; never at >= 90 %) and no nudge in 45 min: send the
                                 keep-improving message. Run by claude-watchdog every 2 min.
  claude-wake status             what is armed / last fired / keep-going decision, plus the log tail
Options: --dry-run (decide and print, never send). Env: CLAUDE_WAKE_USAGE (usage.json path),
CLAUDE_WAKE_SESSION (session jsonl path), CLAUDE_WAKE_STATE (state file), CLAUDE_WAKE_NOW (fake epoch, for tests),
CLAUDE_WAKE_SUBAGENTS (subagent dir), CLAUDE_WAKE_CHANNEL (brepl channel), CLAUDE_WAKE_PACE_OUT (fake claude-pace output).
Fires once per reset (state file ~/.claude/wake-state.json) and never if the main session is busy working normally.
Log: ~/.claude/wake.log
"""
import json, os, subprocess, sys, time, glob

HOME = os.path.expanduser("~")
USAGE = os.environ.get("CLAUDE_WAKE_USAGE", f"{HOME}/.claude/usage.json")
STATE = os.environ.get("CLAUDE_WAKE_STATE", f"{HOME}/.claude/wake-state.json")
LOG = os.environ.get("CLAUDE_WAKE_LOG", os.path.join(os.path.dirname(STATE), "wake.log"))
SOCKS = "/run/user/1000/cc-socks"
LIMIT_PCT = 95
GRACE = 120  # seconds after the reset before waking
BUSY_SECS = 120  # main session wrote its transcript this recently -> it is working
RESUME = ("Usage window has reset. Resume: re-arm the brepl channel watch, run claude-pace, resume every agent that "
          "stopped on the limit with SendMessage (their work is saved), restart the continuous deploy steward if it "
          "stopped, land tested branches, then give Simon a short status.")
DRY = "--dry-run" in sys.argv


def now():
    return float(os.environ.get("CLAUDE_WAKE_NOW") or time.time())


def log(msg):
    line = f"{time.strftime('%Y-%m-%dT%H:%M:%S%z')} {msg}"
    print(line)
    if not DRY:
        with open(LOG, "a") as f:
            f.write(line + "\n")


def hm(t):
    return time.strftime("%a %H:%M", time.localtime(t))


def session_file():
    if os.environ.get("CLAUDE_WAKE_SESSION"):
        return os.environ["CLAUDE_WAKE_SESSION"]
    sid = open(f"{HOME}/.claude/main-session").read().strip()
    return f"{HOME}/.claude/projects/-home-deck/{sid}.jsonl"


def main_pid():
    r = subprocess.run([f"{HOME}/.local/bin/claude-main", "--running"], capture_output=True, text=True)
    p = r.stdout.strip().splitlines()
    return p[0] if r.returncode == 0 and p and p[0].isdigit() else None


def load(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except Exception:
        return default


def save_state(s):
    if DRY:
        return
    tmp = STATE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(s, f, indent=1)
    os.replace(tmp, STATE)


def epoch(v):
    if v is None:
        return None
    if isinstance(v, (int, float)):
        return v / 1000 if v > 1e12 else float(v)
    try:
        from datetime import datetime
        return datetime.fromisoformat(str(v).replace("Z", "+00:00")).timestamp()
    except Exception:
        return None


def last_assistant(path):
    """The main session's last top-level assistant entry (from the transcript's tail)."""
    try:
        with open(path, "rb") as f:
            f.seek(0, 2)
            size = f.tell()
            f.seek(max(0, size - 4_000_000))
            lines = f.read().decode("utf-8", "replace").splitlines()
    except OSError:
        return None
    for line in reversed(lines):
        if '"type":"assistant"' not in line:
            continue
        try:
            e = json.loads(line)
        except Exception:
            continue
        if e.get("type") == "assistant" and not e.get("isSidechain"):
            return e
    return None


def limit_error(e):
    """(reset epoch, kind) if this entry is a usage/rate-limit error, else None."""
    if not e:
        return None
    if not (e.get("isApiErrorMessage") and (e.get("error") == "rate_limit" or e.get("apiErrorStatus") == 429)):
        return None
    q = e.get("quotaLimits") or (e.get("apiErrorParams") or {}).get("rate_limit_info") or {}
    r = epoch(q.get("resetsAt"))
    if r is None:  # fall back to the usage file
        u = load(USAGE, {}).get("rate_limits", {})
        rs = [epoch(w.get("resets_at")) for w in u.values() if isinstance(w, dict) and (w.get("used_percentage") or 0) >= LIMIT_PCT]
        rs = [x for x in rs if x]
        r = max(rs) if rs else None
    return (r, q.get("rateLimitType") or "rate limit") if r else None


def send(text):
    pid = main_pid()
    if not pid:
        log("main Claude is not running (claude-watchdog restarts it); not sending")
        return False
    sock = f"{SOCKS}/{pid}.sock"
    if not os.path.exists(sock):
        log(f"no socket {sock}; not sending")
        return False
    if DRY:
        print(f"DRY RUN: would send to {sock}: {text}")
        return True
    prompt = (f"Use the SendMessage tool exactly once, with to set to \"uds:{sock}\" and message set to the exact text "
              f"between the markers (verbatim, nothing added).\n<<<\n{text}\n>>>\nThen stop and reply DONE.")
    os.makedirs(f"{HOME}/GodotProjects", exist_ok=True)
    try:
        r = subprocess.run([f"{HOME}/.local/bin/claude", "-p", "--model", "haiku", "--strict-mcp-config",
                            "--tools", "SendMessage", "--allowedTools", "SendMessage", "--output-format", "json", prompt],
                           cwd=f"{HOME}/GodotProjects", capture_output=True, text=True, timeout=300)
    except subprocess.TimeoutExpired:
        log("headless send timed out")
        return False
    out = (r.stdout + r.stderr).strip()
    try:
        res = json.loads(r.stdout)
        ok = not res.get("is_error") and res.get("num_turns", 0) >= 2 and not res.get("permission_denials")
    except Exception:
        res, ok = None, False
    log(f"sent to pid {pid}: {'ok' if ok else 'FAILED'}: {text[:80]!r}" + ("" if ok else f" | {out[-400:]}"))
    return ok


def decide():
    """Work out whether a wake-up is needed: returns (reset epoch, why) or None."""
    s = load(STATE, {})
    sess = session_file()
    e = last_assistant(sess)
    err = limit_error(e)
    if err:
        return err[0], f"main session stopped on a {err[1]} limit"
    u = load(USAGE, {}).get("rate_limits", {})
    hits = []
    for name, w in u.items():
        if isinstance(w, dict) and (w.get("used_percentage") or 0) >= LIMIT_PCT and epoch(w.get("resets_at")):
            hits.append((epoch(w["resets_at"]), f"{name} window at {w['used_percentage']}%"))
    hits = [h for h in hits if h[0] + GRACE > now() - 6 * 3600]
    if hits:
        return max(hits)  # the later reset is the one that actually frees requests
    if s.get("armed") and s["armed"] != s.get("fired"):  # armed earlier; usage file has since dropped (reset happened)
        return s["armed"], s.get("why", "armed earlier")
    return None


def busy(reset):
    """The main conversation is working normally: transcript written recently and not ending on a limit error."""
    sess = session_file()
    try:
        m = os.stat(sess).st_mtime
    except OSError:
        return False
    if limit_error(last_assistant(sess)):
        return False
    if m > reset:  # something happened in the conversation since the reset: it is already going again
        return True
    return now() - m < BUSY_SECS


def after_reset(check):
    d = decide()
    s = load(STATE, {})
    if not d:
        print("no wake-up needed (no window at its limit, last turn not a rate-limit error)")
        return 0
    reset, why = d
    if s.get("fired") and abs(s["fired"] - reset) < 60:
        print(f"already woke the session for the {hm(reset)} reset")
        return 0
    if s.get("armed") != reset:
        s.update(armed=reset, why=why, armed_at=now())
        save_state(s)
        log(f"local wake-up armed for {hm(reset + GRACE)} ({why})")
    due = reset + GRACE
    if now() < due:
        if check:
            print(f"armed for {hm(due)} ({why}); not due yet")
            return 0
        print(f"waiting until {hm(due)} ({why})")
        while now() < due:
            time.sleep(min(60, max(1, due - now())))
    if now() - s.get("last_fail", 0) < 600:
        print("last send failed under 10 min ago; retrying later")
        return 0
    if busy(reset):
        log(f"reset {hm(reset)} passed and the main session is already working; no wake-up needed")
        s.update(fired=reset, fired_at=now(), result="skipped (busy)")
        save_state(s)
        return 0
    ok = send(RESUME)
    if ok:
        s.update(fired=reset, fired_at=now(), result="sent")
        save_state(s)
        return 0
    s["failures"] = s.get("failures", 0) + 1
    s["last_fail"] = now()
    save_state(s)
    return 1

# ---- keep-going: nudge the idle main conversation to start the next improvement (Simon: "please don't stop") ----
KEEP_IDLE = 20 * 60  # main transcript, subagent transcripts and brepl jobs all quiet this long
KEEP_EVERY = 45 * 60  # at most one nudge per 45 min
KEEP_MAX_PCT = 90  # never when either window is at/above this
KEEP_GOING = ("Keep improving (Simon's standing rule: don't stop). No agents are running and the budget allows: run "
              "claude-pace, then start the next improvement agent(s) — deeper games with story + procedural generation "
              "(most-played first, per the TV/Deck logs), Dungeon Delve follow-ups, fixes for anything frustrating in "
              "the logs — and make sure the continuous deploy steward is running. Then tell Simon one line.")
CHANNEL = os.environ.get("CLAUDE_WAKE_CHANNEL", f"{HOME}/.cache/brepl/channel.jsonl")


def mtime(p):
    try:
        return os.stat(p).st_mtime
    except OSError:
        return 0.0


def active_subagent():
    """Newest subagent transcript of the main session written within KEEP_IDLE: (name, age secs) or None."""
    d = os.environ.get("CLAUDE_WAKE_SUBAGENTS") or (session_file()[:-len(".jsonl")] + "/subagents")
    best = None
    for f in glob.glob(f"{d}/*.jsonl"):
        age = now() - mtime(f)
        if age < KEEP_IDLE and (best is None or age < best[1]):
            best = (os.path.basename(f), age)
    return best


def active_job():
    """A brepl background-job channel entry from the last KEEP_IDLE: (source, age secs) or None.
    Entries carry only a local HH:MM:SS, so ages are taken modulo a day and only when the file itself is fresh."""
    if now() - mtime(CHANNEL) >= KEEP_IDLE:
        return None
    try:
        with open(CHANNEL, "rb") as f:
            f.seek(0, 2)
            f.seek(max(0, f.tell() - 200_000))
            lines = f.read().decode("utf-8", "replace").splitlines()
    except OSError:
        return None
    lt = time.localtime(now())
    tod = lt.tm_hour * 3600 + lt.tm_min * 60 + lt.tm_sec
    for line in reversed(lines):
        try:
            e = json.loads(line)
            h, m, sec = (int(x) for x in str(e.get("t", "")).split(":"))
        except Exception:
            continue
        age = (tod - (h * 3600 + m * 60 + sec)) % 86400
        if age >= KEEP_IDLE:
            break  # older entries only get older
        if str(e.get("source", "")).startswith("job"):
            return e["source"], age
    return None


def pace_info():
    """Parse claude-pace: {'rec': N, '5-hour': (used, ideal), 'weekly': (used, ideal)}."""
    import re
    out = os.environ.get("CLAUDE_WAKE_PACE_OUT")
    if out is None:
        try:
            out = subprocess.run([f"{HOME}/.local/bin/claude-pace"], capture_output=True, text=True, timeout=60).stdout
        except Exception:
            out = ""
    info = {}
    m = re.search(r"RECOMMENDED AGENTS:\s*(\d+)", out)
    if m:
        info["rec"] = int(m.group(1))
    for name in ("5-hour", "weekly"):
        m = re.search(rf"^{name}: (\d+(?:\.\d+)?)% used.*?ideal now (\d+(?:\.\d+)?)%", out, re.M)
        if m:
            info[name] = (float(m.group(1)), float(m.group(2)))
    return info


def keep_going_reason():
    """None if a nudge should go now, else why not."""
    s = load(STATE, {})
    last = s.get("keep_going_at", 0)
    if now() - last < KEEP_EVERY:
        return f"nudged {int((now() - last) / 60)} min ago (at most every {KEEP_EVERY // 60} min)"
    idle = now() - mtime(session_file())
    if idle < KEEP_IDLE:
        return f"main session busy (transcript written {int(idle / 60)} min ago)"
    a = active_subagent()
    if a:
        return f"agent active ({a[0]} written {int(a[1] / 60)} min ago)"
    j = active_job()
    if j:
        return f"brepl job active ({j[0]} posted {int(j[1] / 60)} min ago)"
    u = load(USAGE, {}).get("rate_limits", {})
    for name, w in u.items():
        if isinstance(w, dict) and (w.get("used_percentage") or 0) >= KEEP_MAX_PCT:
            return f"{name} window at {w['used_percentage']}% (>= {KEEP_MAX_PCT}%)"
    p = pace_info()
    for name in ("5-hour", "weekly"):
        if name in p and p[name][0] >= KEEP_MAX_PCT:
            return f"{name} window at {p[name][0]:.0f}% (>= {KEEP_MAX_PCT}%)"
    if "rec" not in p:
        return "could not read claude-pace"
    wk = p.get("weekly")
    if p["rec"] >= 1:
        return None
    if wk and wk[0] <= wk[1]:
        return None
    return f"budget tight (claude-pace recommends 0 agents, weekly {wk[0]:.0f}% vs ideal {wk[1]:.0f}%)" if wk else \
        "budget tight (claude-pace recommends 0 agents)"


def keep_going(check):
    why = keep_going_reason()
    if why:
        print(f"keep-going: no nudge: {why}")
        return 0
    s = load(STATE, {})
    if now() - s.get("keep_going_fail", 0) < 600:
        print("keep-going: last send failed under 10 min ago; retrying later")
        return 0
    log("keep-going: main idle, no agents/jobs, budget allows -> nudging")
    if send(KEEP_GOING):
        s = load(STATE, {})
        s.update(keep_going_at=now(), keep_going_result="sent")
        save_state(s)
        return 0
    s = load(STATE, {})
    s["keep_going_fail"] = now()
    save_state(s)
    return 1


def main():
    a = [x for x in sys.argv[1:] if x != "--dry-run"]
    if not a or a[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    if a[0] == "now":
        return 0 if send(" ".join(a[1:]) or RESUME) else 1
    if a[0] == "after-reset":
        return after_reset("--check" in a)
    if a[0] == "keep-going":
        return keep_going("--check" in a)
    if a[0] == "status":
        s = load(STATE, {})
        for k in ("armed", "fired"):
            if s.get(k):
                print(f"{k}: reset {hm(s[k])} (wake {hm(s[k] + GRACE)})")
        if s.get("keep_going_at"):
            print(f"last keep-going nudge: {hm(s['keep_going_at'])} ({s.get('keep_going_result')})")
        print(f"keep-going now: {keep_going_reason() or 'would nudge'}")
        print(json.dumps(s))
        try:
            print("--- " + LOG + " (last 10)")
            print("".join(open(LOG).readlines()[-10:]), end="")
        except OSError:
            pass
        return 0
    print(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main())

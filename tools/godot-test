#!/bin/bash
# godot-test ARGS...: run Godot for tests with NO access to the real controllers (Simon's PlayStation pad must never
# connect to a test game). Hides /dev/input and every /dev/hidraw* (SDL reads pads through hidraw too) in a bwrap
# sandbox, same as gdev's offscreen runner. Use this instead of plain `godot` for every headless / bot / merge test.
args=(--dev-bind / / --tmpfs /dev/input --die-with-parent)
for h in /dev/hidraw*; do [ -e "$h" ] && args+=(--ro-bind /dev/null "$h"); done
export SDL_JOYSTICK_HIDAPI=0  # SDL HIDAPI pads off too (same as the offscreen runner)
# Every godot-test run is a test: saves and RUN telemetry go to user://test_saves + telemetry_test.jsonl
# (core/save.gd test_mode). Deck bot runs once wrote 6 fake "deck" rounds into the family's real
# telemetry.jsonl (2026-10-29), which would have skewed balance reports.
export SAVE_TEST=1
# Never the real game's port: a test on 7777 joins the family's live games as a phantom "TV" machine, takes a
# player slot and its LAN beacon pulls real Decks into the test (2026-10-24: kids couldn't all join). Runs that
# pair a host and a joiner already pass the same DUO_PORT to both.
[ -n "$DUO_PORT" ] || export DUO_PORT=$((20000 + RANDOM % 10000))
exec bwrap "${args[@]}" godot "$@"

# Godot cache and gdev runtime data (frames, logs, screenshots)
.godot/
.dev/
*.tmp
.claude/
# thumbs are read from the raw bytes (arcade.gd _thumb), the editor import data is not needed
arcade/thumbs/*.import
# LAN update state of this copy (signed manifest, staging, backup: core/lan_update.gd) and Python caches of tools/
.update/
__pycache__/
# shots / videos written by a tool into the project root by mistake (never real work: see dev.debt stray-file)
/*.png
/*.jpg
/*.mp4
/{*
